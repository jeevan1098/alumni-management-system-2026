                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const employerDropdown = document.getElementById("employerDropdown");
        const otherDiv = document.getElementById("otherEmployerDiv");
        const currentEmployerCheckbox = document.getElementById("isCurrentEmployerCheckbox");
        const endDateField = document.getElementById("endDateField");

        // Show textbox if "Other" selected (value 0 = Other)
        employerDropdown.addEventListener("change", function () {
            otherDiv.style.display = this.value == "0" ? "block" : "none";
        });

        // Disable EndDate if Current Employer is checked
        currentEmployerCheckbox.addEventListener("change", function () {
            endDateField.disabled = this.checked;
            if (this.checked) endDateField.value = "";
        });

        // On page load, check if EndDate is empty and check the checkbox
        window.addEventListener("DOMContentLoaded", function () {
            if (!endDateField.value) {
                currentEmployerCheckbox.checked = true;
                endDateField.disabled = true;
            }
        });
    </script>
} *@


@model Alumni_Management_System.Models.AlumniEmployment

@{
    ViewData["Title"] = "Edit Employment";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAdmin = userRole == "Admin";
    var isAlumni = userRole == "Alumni";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-pencil-square text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">Edit Employment Record</h3>
                    <small class="text-info text-warning">Update employment details for alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="AlumniEmploymentId" />

                <!-- Alumni & Employer Section -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-person-badge-fill me-2 text-warning"></i>Alumni & Employer Information
                </h5>

                <div class="row mb-4">
                    <!-- Alumni -->
                    <div class="col-md-6">
                        <label asp-for="AlumniId" class="form-label fw-semibold">Alumni Name</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-fill text-warning"></i>
                            </span>

                            @if (isAdmin)
                            {
                                <select asp-for="AlumniId"
                                        class="form-select rounded-end-3"
                                        asp-items="ViewBag.AlumniId">
                                    <option value="">Select an alumni</option>
                                </select>
                            }
                            else
                            {
                                <select asp-for="AlumniId"
                                        class="form-select rounded-end-3"
                                        asp-items="ViewBag.AlumniId"
                                        disabled>
                                </select>
                                <input type="hidden" asp-for="AlumniId" value="@currentAlumniId" />
                            }
                        </div>
                        <span asp-validation-for="AlumniId" class="text-danger small"></span>
                    </div>

                    <!-- Employer -->
                    <div class="col-md-6">
                        <label asp-for="EmployerId" class="form-label fw-semibold">Employer Name</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-building text-warning"></i>
                            </span>
                            <select asp-for="EmployerId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.EmployerId"
                                    id="employerDropdown">
                            </select>
                        </div>
                        <span asp-validation-for="EmployerId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Other Employer -->
                <div class="mb-4" id="otherEmployerDiv" style="display:none;">
                    <label class="form-label fw-semibold">Enter Employer Name</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-building-add text-warning"></i>
                        </span>
                        <input type="text"
                               name="OtherEmployerName"
                               class="form-control rounded-end-3"
                               placeholder="Enter employer name" />
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Employment Details -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-briefcase-fill me-2 text-warning"></i>Employment Details
                </h5>

                <div class="row">
                    <!-- Job Title -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="JobTitle" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-workspace text-warning"></i>
                            </span>
                            <input asp-for="JobTitle"
                                   class="form-control rounded-end-3"
                                   placeholder="Enter job title" />
                        </div>
                        <span asp-validation-for="JobTitle" class="text-danger small"></span>
                    </div>

                    <!-- Salary -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="SalaryRange" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-cash-stack text-warning"></i>
                            </span>
                            <select asp-for="SalaryRange"
                                    class="form-select rounded-end-3">
                                <option value="">Select salary range</option>
                                <option value="Below 30,000">Below 30,000</option>
                                <option value="30,000 - 50,000">30,000 - 50,000</option>
                                <option value="50,001 - 75,000">50,001 - 75,000</option>
                                <option value="75,001 - 100,000">75,001 - 100,000</option>
                                <option value="100,001 - 150,000">100,001 - 150,000</option>
                                <option value="150,000+">150,000+</option>
                                <option value="Prefer not to disclose">Prefer not to disclose</option>
                            </select>
                        </div>
                        <span asp-validation-for="SalaryRange" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Start Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-calendar-event-fill text-warning"></i>
                            </span>
                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-calendar-x-fill text-warning"></i>
                            </span>
                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control rounded-end-3"
                                   id="endDateField" />
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Current Employer -->
                <div class="form-check mt-3 mb-4">
                    <input type="checkbox"
                           class="form-check-input"
                           id="isCurrentEmployerCheckbox">
                    <label class="form-check-label fw-semibold"
                           for="isCurrentEmployerCheckbox">
                        Current Employer
                    </label>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill text-white me-2"></i>Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const employerDropdown = document.getElementById("employerDropdown");
        const otherDiv = document.getElementById("otherEmployerDiv");
        const currentEmployerCheckbox = document.getElementById("isCurrentEmployerCheckbox");
        const endDateField = document.getElementById("endDateField");

        employerDropdown.addEventListener("change", function () {
            otherDiv.style.display = this.value == "0" ? "block" : "none";
        });

        currentEmployerCheckbox.addEventListener("change", function () {
            endDateField.disabled = this.checked;
            if (this.checked) endDateField.value = "";
        });

        window.addEventListener("DOMContentLoaded", function () {
            if (!endDateField.value) {
                currentEmployerCheckbox.checked = true;
                endDateField.disabled = true;
            }
        });
    </script>
}