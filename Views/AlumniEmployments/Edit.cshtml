@model Alumni_Management_System.Models.AlumniEmployment

@{
    ViewData["Title"] = "Edit Employment";
    var userRole = ViewData["UserRole"]?.ToString();
    bool isAdmin = userRole == "Admin";
    bool isAlumni = userRole == "Alumni";
    int? currentAlumniId = ViewData["CurrentAlumniId"] as int?;
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
            <i class="bi bi-pencil-fill fs-3 text-primary"></i>
        </div>
        <div>
            <h2 class="fw-bold mb-0">Edit Employment</h2>
            <small class="text-muted">Update employment record</small>
        </div>
    </div>

    <!-- Card -->
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 700px;">
        <div class="card-body p-4">

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="AlumniEmploymentId" />

                <!-- Alumni Name -->
                <div class="mb-3">
                    <label asp-for="AlumniId" class="form-label fw-semibold">Alumni Name</label>
                    @if (isAdmin)
                    {
                        <select asp-for="AlumniId" class="form-select rounded-3" asp-items="ViewBag.AlumniId">
                            <option value="">-- Select an Alumni --</option>
                        </select>
                    }
                    else
                    {
                        <select asp-for="AlumniId" class="form-select rounded-3" asp-items="ViewBag.AlumniId" disabled>
                        </select>
                        <input type="hidden" asp-for="AlumniId" value="@currentAlumniId" />
                    }
                </div>

                <!-- Employer -->
                <div class="mb-3">
                    <label asp-for="EmployerId" class="form-label fw-semibold">Employer Name</label>
                    <select asp-for="EmployerId"
                            class="form-select rounded-3"
                            asp-items="ViewBag.EmployerId"
                            id="employerDropdown">
                        @* <option value="">-- Select Employer --</option> *@
                    </select>
                </div>

                <!-- Other Employer -->
                <div class="mb-3" id="otherEmployerDiv" style="display:none;">
                    <label class="form-label fw-semibold">Enter Employer Name</label>
                    <input type="text"
                           name="OtherEmployerName"
                           class="form-control rounded-3"
                           placeholder="Enter employer name" />
                </div>

                <div class="row g-3">
                    <!-- Job Title -->
                    <div class="col-md-6">
                        <label asp-for="JobTitle" class="form-label fw-semibold"></label>
                        <input asp-for="JobTitle" class="form-control rounded-3" placeholder="Enter job title" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>

                    <!-- Salary Range -->
                    <div class="col-md-6">
                        <label asp-for="SalaryRange" class="form-label fw-semibold"></label>
                        <select asp-for="SalaryRange" class="form-select rounded-3">
                            <option value="">-- Select Salary Range --</option>
                            <option value="Below 30,000">Below 30,000</option>
                            <option value="30,000 - 50,000">30,000 - 50,000</option>
                            <option value="50,001 - 75,000">50,001 - 75,000</option>
                            <option value="75,001 - 100,000">75,001 - 100,000</option>
                            <option value="100,001 - 150,000">100,001 - 150,000</option>
                            <option value="150,000+">150,000+</option>
                            <option value="Prefer not to disclose">Prefer not to disclose</option>
                        </select>
                        <span asp-validation-for="SalaryRange" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <!-- Start Date -->
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" class="form-control rounded-3" id="endDateField" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Current Employer Checkbox -->
                <div class="form-check mt-3 mb-4">
                    <input type="checkbox" class="form-check-input" id="isCurrentEmployerCheckbox">
                    <label class="form-check-label fw-semibold" for="isCurrentEmployerCheckbox">
                        Current Employer
                    </label>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const employerDropdown = document.getElementById("employerDropdown");
        const otherDiv = document.getElementById("otherEmployerDiv");
        const currentEmployerCheckbox = document.getElementById("isCurrentEmployerCheckbox");
        const endDateField = document.getElementById("endDateField");

        // Show textbox if "Other" selected (value 0 = Other)
        employerDropdown.addEventListener("change", function () {
            otherDiv.style.display = this.value == "0" ? "block" : "none";
        });

        // Disable EndDate if Current Employer is checked
        currentEmployerCheckbox.addEventListener("change", function () {
            endDateField.disabled = this.checked;
            if (this.checked) endDateField.value = "";
        });

        // On page load, check if EndDate is empty and check the checkbox
        window.addEventListener("DOMContentLoaded", function () {
            if (!endDateField.value) {
                currentEmployerCheckbox.checked = true;
                endDateField.disabled = true;
            }
        });
    </script>
}
