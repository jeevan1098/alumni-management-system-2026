                <div class="form-check mt-3 mb-4">
                    <input type="checkbox" class="form-check-input" id="isCurrentEmployerCheckbox">
                    <label class="form-check-label fw-semibold" for="isCurrentEmployerCheckbox">
                        Current Employer
                    </label>
