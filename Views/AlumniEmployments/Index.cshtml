@model IEnumerable<Alumni_Management_System.Models.AlumniEmployment>

@{
    ViewData["Title"] = "Alumni Employments";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <!-- Left: Icon + Title -->
            <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-briefcase-fill text-primary fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">Alumni Employments</h3>
                        <small class="text-info">List of alumni employment records</small>
                    </div>
                </div>

                <!-- Right: Add Button -->
                @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-circle-fill me-2"></i>Add Employment
                    </a>
                }
            </div>

            <hr class="mb-4" />

            <!-- Search Form -->
            <form asp-action="Index" method="get" class="mb-4 row g-3">
                <input type="hidden" name="sortOrder" value="@ViewData["SortOrder"]" />

                <!-- Search Input -->
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="searchString"
                            value="@ViewData["CurrentFilter"]"
                            class="form-control"
                            placeholder="Search by name, job title or employer..." />
                    </div>
                </div>

                <!-- Search Button -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 btn-lg text-nowrap">
                        Search
                    </button>
                </div>

                <!-- Reset Button -->
                <div class="col-md-2">
                    <a asp-action="Index"
                    class="btn btn-outline-secondary w-100 btn-lg text-nowrap d-flex align-items-center justify-content-center">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset Filters
                    </a>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-center">
                        @{
                            var sortOrder = ViewData["SortOrder"]?.ToString() ?? "";
                            var search = ViewData["CurrentFilter"]?.ToString() ?? "";
                        }

                        <tr>
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "name" ? "name_desc" : "name", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-person-fill me-1 text-primary"></i>Alumni
                                    @if (sortOrder == "name")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "name_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>

                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "jobtitle" ? "jobtitle_desc" : "jobtitle", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-briefcase-fill me-1 text-primary"></i>Job Title
                                    @if (sortOrder == "jobtitle")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "jobtitle_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>

                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "employer" ? "employer_desc" : "employer", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-building me-1 text-primary"></i>Employer
                                    @if (sortOrder == "employer")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "employer_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>

                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "start" ? "start_desc" : "start", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Start Date
                                    @if (sortOrder == "start")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "start_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>

                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "end" ? "end_desc" : "end", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-calendar-x me-1 text-primary"></i>End Date
                                    @if (sortOrder == "end")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "end_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>

                            <th>
                                <i class="bi bi-cash-stack me-1 text-primary"></i>Salary Range
                            </th>

                            <th>
                                <i class="bi bi-list-task me-2 text-primary"></i>Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.OrderByDescending(e => e.StartDate))
                        {
                            <tr class="text-center">
                                <td>@item.Alumni.FirstName @item.Alumni.LastName</td>
                                <td>@item.JobTitle</td>
                                <td>@item.Employer.EmployerName</td>
                                <td>@item.StartDate.ToString("MMM yyyy")</td>

                                <td>
                                    @if (item.EndDate.HasValue)
                                    {
                                        @item.EndDate.Value.ToString("MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-info">Present</span>
                                    }
                                </td>

                                <td>@item.SalaryRange</td>

                                <td>
                                    <a asp-action="Details" asp-route-id="@item.AlumniEmploymentId" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.AlumniEmploymentId" class="btn btn-sm btn-outline-warning rounded-pill">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.AlumniEmploymentId" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Footer -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>