@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as List<(Alumni_Management_System.Models.AppUser User, string Role)>;
    var allRoles = ViewBag.AllRoles as List<string>;

    var tempPassword = TempData["TempPassword"]?.ToString();
    var resetUserEmail = TempData["ResetPasswordSuccess"]?.ToString();
}

<div class="container-fluid px-4">

    <h2 class="mt-4 mb-3">User Management</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Register" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Register New User
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Current Role</th>
                        <th>Reset Password</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @if (userRoles != null && userRoles.Any())
                    {
                        foreach (var (user, role) in userRoles)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td><span class="badge bg-secondary">@role</span></td>
                                <td>
                                    <form asp-action="ResetPassword" method="post"
                                          onsubmit="return confirm('Reset password for @user.UserName?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            <i class="bi bi-key-fill me-1"></i>Reset
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="DeleteUser" method="post"
                                          onsubmit="return confirm('Permanently delete @user.UserName?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash-fill me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No admin or staff users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-5">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-house-fill me-2"></i>Home
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(tempPassword))
{
    <div class="modal fade" id="tempPasswordModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-key-fill me-2"></i>Temporary Password Generated
                    </h5>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="alert alert-warning border-0 mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Show this to the user only once.</strong> It will not be displayed again.
                    </div>
                    <p class="text-muted mb-2">Password reset for:</p>
                    <p class="fw-bold mb-3">@resetUserEmail</p>
                    <p class="text-muted mb-2">Temporary Password:</p>
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                        <code id="tempPwd" class="fs-4 fw-bold px-4 py-2 bg-light border rounded" style="letter-spacing:2px;">
                            @tempPassword
                        </code>
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyPassword()" title="Copy">
                            <i class="bi bi-clipboard" id="copyIcon"></i>
                        </button>
                    </div>
                    <p class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        The user will be required to change this password on their next login.
                    </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-warning px-5 fw-bold" data-bs-dismiss="modal">
                        <i class="bi bi-check-circle me-1"></i>I've noted the password
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', function () {
            new bootstrap.Modal(document.getElementById('tempPasswordModal')).show();
        });
        function copyPassword() {
            navigator.clipboard.writeText(document.getElementById('tempPwd').innerText.trim()).then(function () {
                var icon = document.getElementById('copyIcon');
                icon.classList.replace('bi-clipboard', 'bi-clipboard-check');
                setTimeout(function () { icon.classList.replace('bi-clipboard-check', 'bi-clipboard'); }, 2000);
            });
        }
    </script>
}
