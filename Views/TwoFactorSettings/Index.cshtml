@model Alumni_Management_System.Models.AppUser

@{
    ViewData["Title"] = "Two-Factor Authentication";
    var isMandatory = (bool)(ViewData["IsMandatory"] ?? false);
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Two-Factor Authentication</h3>
                    <small class="text-info">Add an email verification code to your login</small>
                </div>
            </div>

            <hr class="mb-4" />

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <p>
                When enabled, after entering your password you'll be emailed a one-time
                verification code at <strong>@Model.Email</strong> that you must enter to finish signing in.
            </p>

            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-4" style="background:#f8f9fa;">
                <div>
                    <strong>Status:</strong>
                    @if (Model.TwoFactorEnabled)
                    {
                        <span class="badge bg-success ms-2">Enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">Disabled</span>
                    }
                    @if (isMandatory)
                    {
                        <div class="small text-muted mt-1">Mandatory for Admin and Staff accounts.</div>
                    }
                </div>

                @if (Model.TwoFactorEnabled)
                {
                    <form asp-action="Disable" method="post">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4" @(isMandatory ? "disabled" : "")>
                            <i class="bi bi-x-circle me-2"></i>Disable
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="Enable" method="post">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-check-circle me-2"></i>Enable
                        </button>
                    </form>
                }
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back
                </a>
            </div>

        </div>
    </div>
</div>
