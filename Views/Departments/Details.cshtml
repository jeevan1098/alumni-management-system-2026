@model Alumni_Management_System.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-columns-gap text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Department Details</h3>
                    <small class="text-info">@Model.DepartmentName</small>
                </div>
            </div>

            <hr class="mb-4" />

            <dl class="row mb-4">
                <dt class="col-sm-3">Department Name</dt>
                <dd class="col-sm-9">@Model.DepartmentName</dd>

                <dt class="col-sm-3">College</dt>
                <dd class="col-sm-9">@Model.College?.CollegeName</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            </div>

        </div>
    </div>
</div>
