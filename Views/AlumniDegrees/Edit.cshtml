

@model Alumni_Management_System.Models.AlumniDegree

@{
    ViewData["Title"] = "Edit Degree";
}
@{
    ViewData["Title"] = "Alumni Directory";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAlumni = userRole == "Alumni";
    var isAdmin = userRole == "Admin";
    var isStaff = userRole == "Staff";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-pencil-square text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">Edit Degree Record</h3>
                    <small class="text-info text-warning">Update academic information for alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="AlumniDegreeId" />

                <!-- Alumni & Degree Section -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-person-badge-fill me-2 text-warning"></i>Alumni & Degree Information
                </h5>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Alumni</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-fill text-warning"></i>
                            </span>
                            <select asp-for="AlumniId" class="form-select rounded-end-3" asp-items="ViewBag.AlumniId">
                                @if (isAdmin)
                                {
                                    <option value="">Select an alumni</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="AlumniId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Degree Program</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-book-fill text-warning"></i>
                            </span>
                            <select asp-for="DegreeId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.DegreeId">
                                <option value="">Select a degree program</option>
                            </select>
                        </div>
                        <span asp-validation-for="DegreeId" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Academic Details -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-journal-check me-2 text-warning"></i>Academic Details
                </h5>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateConferred" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-calendar-event-fill text-warning"></i>
                            </span>
                            <input asp-for="DateConferred"
                                   type="date"
                                   class="form-control rounded-end-3" readonly/>
                        </div>
                        <span asp-validation-for="DateConferred" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="YearsToCompleteDegree" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-clock-fill text-warning"></i>
                            </span>
                            <input asp-for="YearsToCompleteDegree"
                                   placeholder="e.g. 4 years"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="YearsToCompleteDegree" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Gpa" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-bar-chart-fill text-warning"></i>
                            </span>
                            <input asp-for="Gpa"
                                   placeholder="e.g. 3.75"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="Gpa" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Career & Experience -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-briefcase-fill me-2 text-warning"></i>Career & Experience
                </h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="EmploymentWhileStudying" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-building text-warning"></i>
                            </span>
                            <input asp-for="EmploymentWhileStudying"
                                   placeholder="Eg: Part-time software developer at XYZ Corp"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="EmploymentWhileStudying" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DegreeSpecificJob" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-briefcase text-warning"></i>
                            </span>
                            <select asp-for="DegreeSpecificJob"
                                    class="form-select rounded-end-3">
                                <option value="">Select an option</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <span asp-validation-for="DegreeSpecificJob" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ParticipatedInResearch" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search text-warning"></i>
                            </span>
                            <select asp-for="ParticipatedInResearch"
                                    class="form-select rounded-end-3">
                                <option value="">Select an option</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <span asp-validation-for="ParticipatedInResearch" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="JobSecuredUponGraduation" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-award-fill text-warning"></i>
                            </span>
                            <select asp-for="JobSecuredUponGraduation"
                                    class="form-select rounded-end-3">
                                <option value="">Select an option</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <span asp-validation-for="JobSecuredUponGraduation" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AttendedOrPlansGradSchool" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-mortarboard text-warning"></i>
                            </span>
                            <select asp-for="AttendedOrPlansGradSchool"
                                    class="form-select rounded-end-3">
                                <option value="">Select an option</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <span asp-validation-for="AttendedOrPlansGradSchool" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2 text-primary"></i>Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
