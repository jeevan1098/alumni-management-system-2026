@model IEnumerable<Alumni_Management_System.Models.AlumniDegree>

@{
    ViewData["Title"] = "Alumni Degrees";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-mortarboard-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Alumni Degrees</h3>
                    <small class="text-info">List of degrees and key academic/career info</small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="d-flex justify-content-end mb-3">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-circle-fill me-2"></i>Add Degree
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th><i class="bi bi-credit-card-2-front-fill me-1 text-primary"></i>Jag ID</th>
                            <th><i class="bi bi-person-fill me-1 text-primary"></i>Alumni</th>
                            <th><i class="bi bi-mortarboard-fill me-1 text-primary"></i>Degree Program</th>
                            <th><i class="bi bi-bar-chart-fill me-1 text-primary"></i>GPA</th>
                            <th><i class="bi bi-calendar-event me-1 text-primary"></i>Date Conferred</th>
                            <th><i class="bi bi-award-fill me-1 text-primary"></i>Job Secured</th>
                            <th><i class="bi bi-list-task me-2 text-primary"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(d => d.DateConferred))
                        {
                            <tr>
                                <td class="fw-semibold text-center">@item.Alumni.JagId</td>
                                <td class="text-center">@item.Alumni.FirstName @item.Alumni.LastName</td>
                                <td class="text-center">@item.Degree.DegreeType</td>
                                <td class="text-center">@item.Gpa</td>
                                <td class="text-center">@item.DateConferred.ToString("MMM yyyy")</td>
                                <td class="text-center">
                                    @if (item.JobSecuredUponGraduation == true)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-info">
                                            <i class="bi bi-x-circle me-1"></i>No
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.AlumniDegreeId"
                                       class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.AlumniDegreeId"
                                       class="btn btn-sm btn-outline-warning rounded-pill">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.AlumniDegreeId"
                                       class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

