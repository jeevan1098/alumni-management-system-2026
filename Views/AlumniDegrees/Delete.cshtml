@model Alumni_Management_System.Models.AlumniDegree

@{
    ViewData["Title"] = "Delete Degree";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-trash-fill text-danger fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Delete Degree Record</h3>
                    <small class="text-muted">Are you sure you want to delete this record?</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Alumni & Degree Info -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-person-badge-fill me-2"></i>Alumni & Degree Information
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="bi bi-person-fill me-1"></i> Alumni</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Alumni.FirstName)</dd>

                <dt class="col-sm-3"><i class="bi bi-book-fill me-1"></i> Degree Program</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Degree.DegreeType)</dd>
            </dl>

            <!-- Academic Details -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-journal-check me-2"></i>Academic Details
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="bi bi-bar-chart-fill me-1"></i> GPA</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Gpa)</dd>

                <dt class="col-sm-3"><i class="bi bi-calendar-event-fill me-1"></i> Date Conferred</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DateConferred)</dd>

                <dt class="col-sm-3"><i class="bi bi-award-fill me-1"></i> Job Secured Upon Graduation</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.JobSecuredUponGraduation)</dd>
            </dl>

            <!-- Career & Experience -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-briefcase-fill me-2"></i>Career & Experience
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="bi bi-building me-1"></i> Employment While Studying</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EmploymentWhileStudying)</dd>

                <dt class="col-sm-3"><i class="bi bi-briefcase me-1"></i> Degree Specific Job</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DegreeSpecificJob)</dd>

                <dt class="col-sm-3"><i class="bi bi-search me-1"></i> Participated in Research</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ParticipatedInResearch)</dd>

                <dt class="col-sm-3"><i class="bi bi-mortarboard me-1"></i> Attended / Plans Grad School</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AttendedOrPlansGradSchool)</dd>
            </dl>

            <!-- Delete Confirmation Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="AlumniDegreeId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

