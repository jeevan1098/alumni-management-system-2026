@model Alumni_Management_System.Models.AlumniMessage

@{
    ViewData["Title"] = "Delete Message";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-trash-fill text-danger fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Delete Message of <span class="text-primary">@Model.Alumni.FirstName @Model.Alumni.LastName</span>
                    </h3>
                    <small class="text-muted">Are you sure you want to permanently delete this message?</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Message Details -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-chat-text-fill me-2 text-danger"></i>Message Information
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="bi bi-calendar-event me-1"></i>Sent At</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.SentAt)</dd>

                <dt class="col-sm-3"><i class="bi bi-person-fill me-1"></i>Alumni</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Alumni.FirstName) @Html.DisplayFor(model => model.Alumni.LastName)</dd>

                <dt class="col-sm-3"><i class="bi bi-chat-left-text-fill me-1"></i>Message</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Message.MessageBody)</dd>
            </dl>

            <!-- Delete Confirmation Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="AlumniMessageId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>