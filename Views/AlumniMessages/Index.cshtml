@model IEnumerable<Alumni_Management_System.Models.AlumniMessage>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SentAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alumni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Message)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SentAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alumni.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Message.MessageBody)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AlumniMessageId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AlumniMessageId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AlumniMessageId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
