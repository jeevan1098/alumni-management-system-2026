@model Alumni_Management_System.Models.AlumniMessage

@{
    ViewData["Title"] = "Edit Alumni Message";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-envelope-paper-fill text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">Edit Alumni Message</h3>
                    <small class="text-muted text-warning">
                        Update message details sent to alumni
                    </small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="AlumniMessageId" />

                <!-- Alumni & Message Selection -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-person-lines-fill me-2 text-warning"></i>
                    Alumni & Message Information
                </h5>

                <div class="row mb-4">

                    <!-- Alumni -->
                    <div class="col-md-6">
                        <label asp-for="AlumniId" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-fill text-warning"></i>
                            </span>
                            <select asp-for="AlumniId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.AlumniId">
                            </select>
                        </div>
                        <span asp-validation-for="AlumniId" class="text-danger small"></span>
                    </div>

                    <!-- Message -->
                    <div class="col-md-6">
                        <label asp-for="MessageId" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-chat-left-text-fill text-warning"></i>
                            </span>
                            <select asp-for="MessageId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.MessageId">
                            </select>
                        </div>
                        <span asp-validation-for="MessageId" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Message Details -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-clock-history me-2 text-warning"></i>
                    Message Timing
                </h5>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="SentAt" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-calendar-event-fill text-warning"></i>
                            </span>
                            <input asp-for="SentAt"
                                   type="datetime-local"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="SentAt" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill text-white me-2"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}