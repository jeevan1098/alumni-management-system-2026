@model Alumni_Management_System.Models.AlumniMessage

@{
    ViewData["Title"] = "Message Details";
    var alumniName = Model.Alumni != null
        ? $"{(!string.IsNullOrEmpty(Model.Alumni.PreferredFirstName) ? Model.Alumni.PreferredFirstName : Model.Alumni.FirstName)} {Model.Alumni.LastName}"
        : "Unknown Alumni";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-envelope-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Message Details of <span class="text-primary">@alumniName</span>
                    </h3>
                    <small class="text-info">View message information for this alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="row g-4">
                <!-- Message Info -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-chat-text me-2"></i>Message Information
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">Sent At</dt>
                        <dd class="col-sm-7">
                            @if (Model.SentAt != DateTime.MinValue)
                            {
                                @Model.SentAt.ToString("MMMM dd, yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Alumni</dt>
                        <dd class="col-sm-7">
                            @alumniName
                        </dd>
                    </dl>
                </div>

                <!-- Message Body -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-card-text me-2"></i>Message Body
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Message</dt>
                        <dd class="col-sm-8">
                            @if (Model.Message != null && !string.IsNullOrEmpty(Model.Message.MessageBody))
                            {
                                @Model.Message.MessageBody
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.AlumniMessageId" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            </div>

        </div>
    </div>
</div>