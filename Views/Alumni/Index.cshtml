@section Scripts {
    <script>
        function toggleView(viewType) {
            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');
            const cardViewBtn = document.getElementById('cardViewBtn');
            const tableViewBtn = document.getElementById('tableViewBtn');

            if (viewType === 'card') {
                cardView.style.display = 'flex';
                tableView.style.display = 'none';
                cardViewBtn.classList.add('active');
                tableViewBtn.classList.remove('active');
                localStorage.setItem('alumniDirectoryView', 'card');
            } else {
                cardView.style.display = 'none';
                tableView.style.display = 'block';
                tableViewBtn.classList.add('active');
                cardViewBtn.classList.remove('active');
                localStorage.setItem('alumniDirectoryView', 'table');
            }
        }

        // Restore saved view preference on page load
        document.addEventListener('DOMContentLoaded', function() {
            const savedView = localStorage.getItem('alumniDirectoryView') || 'card';
            toggleView(savedView);
        });
    </script>
} *@
@model IEnumerable<Alumni_Management_System.Models.Alumni>

@{
    ViewData["Title"] = "Alumni Directory";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAlumni = userRole == "Alumni";
    var isAdmin = userRole == "Admin";
    var isStaff = userRole == "Staff";
    var hasTableTools = User.IsInRole("Admin") || User.IsInRole("Staff");
}

<div class="container mt-5 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Html.Raw(TempData["SuccessMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["UpdateMessages"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <strong>Existing records updated:</strong><br />
            @Html.Raw(TempData["UpdateMessages"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessages"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Import Errors:</strong><br />
            @Html.Raw(TempData["ErrorMessages"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                <i class="bi bi-people-fill text-primary fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Alumni Directory</h3>
                <small class="text-info">
                    @if (isAlumni)
                    {
                        <text>Connect with fellow alumni</text>
                    }
                    else if (isAdmin)
                    {
                        <text>Manage and view alumni records</text>
                    }
                    else
                    {
                        <text>View alumni records</text>
                    }
                </small>
            </div>
        </div>

        <!-- Toggle (ONLY FOR ALUMNI) -->
        @if (isAlumni)
        {
            <div class="btn-group" role="group">
                <button id="tableViewBtn" class="btn btn-outline-secondary active"
                        onclick="toggleView('table')" type="button">
                    <i class="bi bi-table text-danger"></i>
                </button>
                <button id="cardViewBtn" class="btn btn-outline-secondary"
                        onclick="toggleView('card')" type="button">
                    <i class="bi bi-grid text-danger"></i>
                </button>
            </div>
        }
        else if(isAdmin)
        {
            <div class="d-flex justify-content-end mb-3">
                <a asp-controller="AlumniDegrees" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Add New Alumni Degree
                </a>
            </div>
            <div class="d-flex justify-content-end mb-3">
                <a asp-controller="Alumni" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Add New Alumni
                </a>
            </div>
            <div class="d-flex justify-content-end mb-3">
                <a asp-controller="AlumniRegistries" asp-action="BulkImport" class="btn btn-outline-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-upload me-2"></i>Bulk Import
                </a>
            </div>
        }
    </div>

    @if (ViewData["ScopeLabel"] != null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-shield-lock me-2"></i>
            Your access is scoped to: <strong>@ViewData["ScopeLabel"]</strong>. You're only seeing alumni from this college.
        </div>
    }

    @if (currentAlumniId.HasValue)
    {
        <!-- Also matters for an Admin/Staff account that ALSO holds the
             Alumni role (see UsersController.AddRole) - the table below
