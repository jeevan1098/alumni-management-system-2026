@model IEnumerable<Alumni_Management_System.Models.Alumni>

@{
    ViewData["Title"] = "Alumni Directory";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAlumni = userRole == "Alumni";
    var isAdmin = userRole == "Admin";
    var isStaff = userRole == "Staff";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                <i class="bi bi-people-fill text-primary fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Alumni Directory</h3>
                <small class="text-info">
                    @if (isAlumni)
                    {
                        <text>Connect with fellow alumni</text>
                    }
                    else if (isAdmin)
                    {
                        <text>Manage and view alumni records</text>
                    }
                    else
                    {
                        <text>View alumni records</text>
                    }
                </small>
            </div>
        </div>

        <!-- View Toggle: Alumni only -->
        @if (isAlumni)
        {
            <div class="btn-group" role="group">
                <button id="tableViewBtn" class="btn btn-outline-secondary active"
                        onclick="toggleView('table')" type="button">
                    <i class="bi bi-table text-danger"></i>
                </button>
                <button id="cardViewBtn" class="btn btn-outline-secondary"
                        onclick="toggleView('card')" type="button">
                    <i class="bi bi-grid text-danger"></i>
                </button>
            </div>
        }
        else if (isAdmin)
        {
            <div class="d-flex justify-content-end mb-3">
                <a asp-controller="Alumni" asp-action="BulkImport" class="btn btn-primary rounded-pill px-4 shadow-sm me-2">
                    <i class="bi bi-upload me-2"></i>Bulk Import Alumni
                </a>
                <a asp-controller="Alumni" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Add New Alumni
                </a>
            </div>
        }
    </div>
    @if (isAdmin)
    {
        <!-- Search -->
        <form asp-action="Index" method="get" class="mb-4 row g-3">
            <input type="hidden" name="sortOrder" value="@ViewData["SortOrder"]" />
            <div class="col-md-8">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-primary"></i>
                    </span>
                    <input type="text" name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="@(isAlumni ? "Search by name or email..." : "Search by name, JAG ID or email...")" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 btn-lg">Search</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 btn-lg">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </a>
            </div>
        </form>
    }
    <!-- ================= TABLE VIEW ================= -->
    <div id="tableView">
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        @{
                            var sortOrder = ViewData["SortOrder"]?.ToString() ?? "";
                            var search = ViewData["CurrentFilter"]?.ToString() ?? "";
                        }
                        @if (isAdmin || isStaff)
                        {
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "jagid" ? "jagid_desc" : "jagid", searchString = search })"
                                   class="text-white text-decoration-none">
                                    <i class="bi bi-credit-card-2-front-fill me-1 text-primary"></i>Jag ID
                                    @if (sortOrder == "jagid")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "jagid_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                        }
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = sortOrder == "name" ? "name_desc" : "name", searchString = search })"
                               class="text-white text-decoration-none">
                                <i class="bi bi-person-fill me-1 text-primary"></i>Name
                                @if (sortOrder == "name")
                                {
                                    <span>▲</span>
                                }
                                else if (sortOrder == "name_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = sortOrder == "email" ? "email_desc" : "email", searchString = search })"
                               class="text-white text-decoration-none">
                                <i class="bi bi-envelope-fill me-1 text-primary"></i>Email
                                @if (sortOrder == "email")
                                {
                                    <span>▲</span>
                                }
                                else if (sortOrder == "email_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = sortOrder == "year" ? "year_desc" : "year", searchString = search })"
                               class="text-white text-decoration-none">
                                <i class="bi bi-mortarboard-fill me-1 text-primary"></i>Grad Year
                                @if (sortOrder == "year")
                                {
                                    <span>▲</span>
                                }
                                else if (sortOrder == "year_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        @if (isAdmin || isStaff)
                        {
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "city" ? "city_desc" : "city", searchString = search })"
                                   class="text-white text-decoration-none">
                                    <i class="bi bi-building me-1 text-primary"></i>City
                                    @if (sortOrder == "city")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "city_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "state" ? "state_desc" : "state", searchString = search })"
                                   class="text-white text-decoration-none">
                                    <i class="bi bi-geo-alt-fill me-1 text-primary"></i>State
                                    @if (sortOrder == "state")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "state_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                        }
                        @if (isAlumni)
                        {
                            <th><i class="bi bi-globe me-1 text-primary"></i>Social Media</th>
                        }
                        <th><i class="bi bi-list-task me-2 text-primary"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    No alumni found.
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            @if (isAdmin || isStaff)
                            {
                                <td class="fw-bolder">@item.JagId</td>
                            }
                            <td>
                                @item.Prefix @item.FirstName @item.LastName
                                @if (!string.IsNullOrEmpty(item.PreferredFirstName))
                                {
                                    <br />
                                    <small class="text-info">(@item.PreferredFirstName)</small>
                                }
                            </td>
                            <td>@item.PermanentEmail</td>
                            <td>@item.GraduationYear</td>
                            @if (isAdmin || isStaff)
                            {
                                <td>@item.City</td>
                                <td>@item.State</td>
                            }
                            @if (isAlumni)
                            {
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SocialMediaAccount))
                                    {
                                        <a href="@item.SocialMediaAccount" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="bi bi-globe me-1"></i>View
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            }

                            @if (isAdmin)
                            {
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-primary rounded-circle me-1" title="View">
                                            <i class="bi bi-eye-fill text-primary"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-warning rounded-circle me-1" title="Edit">
                                            <i class="bi bi-pencil-fill text-warning"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                            <i class="bi bi-trash-fill text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                            else if (isStaff || isAlumni)
                            {
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.AlumniId"
                                       class="btn btn-sm btn-outline-primary rounded-circle" title="View">
                                        <i class="bi bi-eye-fill text-primary"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= CARD VIEW (ALUMNI ONLY) ================= -->
    @if (isAlumni)
    {
        <div id="cardView" class="row" style="display:none;">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:60px;height:60px;">
                                    <i class="bi bi-person-fill text-primary fs-4"></i>
                                </div>
                                <div class="ms-3">
                                    <h5 class="mb-0">
                                        @item.Prefix @item.FirstName @item.LastName
                                    </h5>
                                    <small class="text-info">Class of @item.GraduationYear</small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.PermanentEmail))
                            {
                                <p class="mb-1">
                                    <i class="bi bi-envelope-fill text-primary me-2"></i>
                                    @item.PermanentEmail
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(item.SocialMediaAccount))
                            {
                                <p class="mb-0">
                                    <i class="bi bi-globe text-primary me-2"></i>
                                    <a href="@item.SocialMediaAccount" target="_blank">View Social Profile</a>
                                </p>
                            }
                            else
                            {
                                <p class="mb-0 text-muted">
                                    <i class="bi bi-globe text-muted me-2"></i>No social media listed
                                </p>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-0">
                            <a asp-action="Details" asp-route-id="@item.AlumniId"
                               class="btn btn-primary w-100">
                                <i class="bi bi-eye-fill text-white me-1"></i> View Profile
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="d-flex justify-content-between mt-5">
        <a asp-action="Index" asp-controller="Home"
            class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-house-fill me-2"></i>Home
        </a>
    </div>

</div>

@section Scripts {
    <script>
        function toggleView(viewType) {
            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');
            const cardBtn = document.getElementById('cardViewBtn');
            const tableBtn = document.getElementById('tableViewBtn');

            if (!cardView) return;

            if (viewType === 'card') {
                tableView.style.display = 'none';
                cardView.style.display = 'flex';
                cardBtn.classList.add('active');
                tableBtn.classList.remove('active');
            } else {
                tableView.style.display = 'block';
                cardView.style.display = 'none';
                tableBtn.classList.add('active');
                cardBtn.classList.remove('active');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggleView('table');
        });
    </script>
}