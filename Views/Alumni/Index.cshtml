            <a asp-action="MyProfile" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-person-badge me-2"></i>My Alumni Profile
            </a>
        </div>
    }

    <!-- Search - Admin/Staff get the live "Search this table" box above the
         table instead (wwwroot/js/admin-enhance.js), so only show this one
         to everyone else. -->
