                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i> Clear Search
                </a>
            </div>
        }
    </form>

    @if (isAlumni)
    {
        <!-- Card layout for Alumni -->
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-md-12">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> No alumni found.
