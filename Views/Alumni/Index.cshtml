                        <th>@Html.DisplayNameFor(m => m.PermanentEmail)</th>
                        <th>@Html.DisplayNameFor(m => m.Phone)</th>
                        <th>@Html.DisplayNameFor(m => m.GraduationYear)</th>
                        <th>@Html.DisplayNameFor(m => m.City)</th>
                        <th>@Html.DisplayNameFor(m => m.State)</th>
