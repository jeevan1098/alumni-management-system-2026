                                    <br />
                                    <small class="text-info">
                                        (@item.PreferredFirstName)
                                    </small>
                                }
                            </td>
                            <td>@item.PermanentEmail</td>
                            <td>@item.Phone</td>
                            <td>@item.GraduationYear</td>
                            <td>@item.City</td>
                            <td>@item.State</td>

                            @* @if (!isAlumni)
                            {
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                            } *@
                            @if (isAdmin)
                            {
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-primary rounded-circle me-1"
                                           title="View">
                                            <i class="bi bi-eye-fill text-primary"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-warning rounded-circle me-1"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill text-warning"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-danger rounded-circle"
                                           title="Delete">
                                            <i class="bi bi-trash-fill text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                            else if (isAlumni)
                            {
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.AlumniId"
                                       class="btn btn-sm btn-outline-primary rounded-circle"
                                       title="View">
                                        <i class="bi bi-eye-fill text-primary"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!-- ================= CARD VIEW (ALUMNI ONLY) ================= -->
    @if (isAlumni)
    {
        <div id="cardView" class="row" style="display:none;">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:60px;height:60px;">
                                    <i class="bi bi-person-fill text-primary fs-4"></i>
                                </div>

                                <div class="ms-3">
                                    <h5 class="mb-0">
                                        @item.FirstName @item.LastName
                                    </h5>
                                    <small class="text-info">
                                        @item.GraduationYear
                                    </small>
                                </div>
                            </div>

                            <p class="mb-1">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>
                                @item.PermanentEmail
                            </p>

                            <p class="mb-1">
                                <i class="bi bi-telephone-fill text-primary me-2"></i>
                                @item.Phone
                            </p>

                            <p class="mb-0">
                                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                                @item.City, @item.State
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-0">
                            <a asp-action="Details"
                               asp-route-id="@item.AlumniId"
                               class="btn btn-primary w-100">
                                <i class="bi bi-eye-fill text-white me-1"></i>
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>


@section Scripts {
    <script>
        function toggleView(viewType) {

            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');
            const cardBtn = document.getElementById('cardViewBtn');
            const tableBtn = document.getElementById('tableViewBtn');

            if (!cardView) return;

            if (viewType === 'card') {
                tableView.style.display = 'none';
                cardView.style.display = 'flex';
                cardBtn.classList.add('active');
                tableBtn.classList.remove('active');
            } else {
                tableView.style.display = 'block';
                cardView.style.display = 'none';
                tableBtn.classList.add('active');
                cardBtn.classList.remove('active');
            }
        }

        // Default = TABLE VIEW
        document.addEventListener('DOMContentLoaded', function () {
            toggleView('table');
        });
    </script>
}

