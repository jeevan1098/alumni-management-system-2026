    {
    <form asp-action="Index" method="get" class="mb-4 row g-3">
        <div class="col-md-10">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" name="searchString"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control"
                       placeholder="Search by name, JAG ID or email..." />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Search
            </button>
        </div>
    </form>
    }


    <!-- ================= TABLE VIEW ================= -->
    <div id="tableView">

        @if (isAdmin)
        {
            <div id="bulkBar" class="alert alert-danger d-flex flex-wrap align-items-center gap-2 py-2 mb-3 d-none">
                <i class="bi bi-check2-square"></i>
                <span><strong id="bulkCount">0</strong> selected</span>
                <button type="button" class="btn btn-sm btn-link ms-1" id="bulkClear">Clear selection</button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 ms-auto" data-bs-toggle="modal" data-bs-target="#bulkDeleteModal">
                    <i class="bi bi-trash-fill me-1"></i>Delete selected
                </button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        @if (isAdmin)
                        {
                            <th data-no-sort style="width:1%">
                                <input type="checkbox" class="form-check-input" id="selectAllAlumni" title="Select all shown" aria-label="Select all shown alumni" />
                            </th>
                        }
                        <th>Jag ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Grad Year</th>
                        <th>City</th>
                        <th>State</th>
                        @* @if (!isAlumni)
                        {
                            <th>Status</th>
                        } *@
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    No alumni found.
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            @if (isAdmin)
                            {
                                <td>
                                    <input type="checkbox" class="form-check-input alumni-select" name="ids" value="@item.AlumniId" form="bulkDeleteForm" aria-label="Select @item.FirstName @item.LastName" />
                                </td>
                            }
                            <td>@item.JagId</td>
                            <td>
                                @item.FirstName @item.LastName
                                @if (!string.IsNullOrEmpty(item.PreferredFirstName))
                                {
                                    <br />
                                    <small class="text-info">
                                        (@item.PreferredFirstName)
                                    </small>
                                }
                            </td>
                            @if (item.ContactHidden)
                            {
                                <td><span class="text-muted" title="This alumnus keeps their contact details private"><i class="bi bi-lock-fill me-1"></i>Private</span></td>
                                <td><span class="text-muted" title="This alumnus keeps their contact details private"><i class="bi bi-lock-fill me-1"></i>Private</span></td>
                            }
                            else
                            {
                                <td>@item.PermanentEmail</td>
                                <td>@item.Phone</td>
                            }
                            <td>@item.GraduationYear</td>
                            <td>@item.City</td>
                            <td>@item.State</td>

                            @* @if (!isAlumni)
                            {
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                            } *@
                            @if (isAdmin)
                            {
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-primary rounded-circle me-1"
                                           title="View">
                                            <i class="bi bi-eye-fill text-primary"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-warning rounded-circle me-1"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill text-warning"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.AlumniId"
                                           class="btn btn-sm btn-outline-danger rounded-circle"
                                           title="Delete">
                                            <i class="bi bi-trash-fill text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                            else if (isAlumni)
                            {
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.AlumniId"
                                       class="btn btn-sm btn-outline-primary rounded-circle"
                                       title="View">
                                        <i class="bi bi-eye-fill text-primary"></i>
                                    </a>
                                </td>
                            }
                            else
                            {
                                <!-- Staff (read-only), including a Staff account
                                     that also holds the Alumni role - they can
                                     still edit their OWN record (see
                                     AlumniController.Edit's own-profile check). -->
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.AlumniId"
                                       class="btn btn-sm btn-outline-primary rounded-circle me-1"
                                       title="View">
                                        <i class="bi bi-eye-fill text-primary"></i>
                                    </a>
