                else
                {
                    <text>View all alumni profiles</text>
                }
            </small>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mb-4 d-flex flex-wrap gap-2">
        @if (isAlumni && currentAlumniId.HasValue)
        {
            <a asp-action="MyProfile" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-person-badge me-2"></i> My Profile
            </a>
        }
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-2"></i> Create New Alumni
            </a>
