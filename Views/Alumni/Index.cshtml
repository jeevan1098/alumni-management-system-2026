@* @model IEnumerable<Alumni_Management_System.Models.Alumni>

@{
    ViewData["Title"] = "Alumni Directory";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAlumni = userRole == "Alumni";
    var isAdmin = userRole == "Admin";
    var isStaff = userRole == "Staff";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1><i class="bi bi-people-fill"></i> Alumni Directory</h1>
        <p class="text-info">
            @if (isAlumni)
            {
                <text>Connect with fellow alumni who have chosen to be visible in the directory</text>
            }
            else if (isAdmin)
            {
                <text>Manage and view all alumni profiles</text>
            }
            else
            {
                <text>View all alumni profiles</text>
            }
        </p>
    </div>
</div>

<!-- Action Buttons -->
<div class="row mb-3">
    <div class="col-md-6">
        @if (isAlumni && currentAlumniId.HasValue)
        {
            <a asp-action="MyProfile" class="btn btn-primary btn-lg mb-2">
                <i class="bi bi-person-badge"></i> My Profile
            </a>
        }
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success mb-2">
                <i class="bi bi-plus-circle"></i> Create New Alumni
            </a>
        }
    </div>
    @if (isAlumni)
    {
        <div class="col-md-6 text-end">
            <div class="btn-group" role="group" aria-label="View toggle">
                <button type="button" class="btn btn-outline-primary active" id="cardViewBtn" onclick="toggleView('card')">
                    <i class="bi bi-grid-3x3-gap-fill"></i> Card View
                </button>
                <button type="button" class="btn btn-outline-primary" id="tableViewBtn" onclick="toggleView('table')">
                    <i class="bi bi-table"></i> Table View
                </button>
            </div>
        </div>
    }
</div>

<!-- Search Bar -->
<div class="row mb-4">
    <div class="col-md-12">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-10">
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                           class="form-control" placeholder="Search by name, JAG ID, or email..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100">Search</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
        {
            <div class="mt-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Clear Search
                </a>
            </div>
        }
    </div>
</div>
@if (isAlumni)
{
    <!-- Card View for Alumni Users -->
    <div class="row" id="cardView">
        @if (!Model.Any())
        {
            <div class="col-md-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No alumni found matching your search criteria.
                </div>
            </div>
        }
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 60px; height: 60px; font-size: 24px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="ms-3">
                                <h5 class="card-title mb-0">
                                    @(!string.IsNullOrEmpty(item.PreferredFirstName) ? item.PreferredFirstName : item.FirstName) @item.LastName
                                </h5>
                                <small class="text-info">@item.JagId</small>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-2">
                            <i class="bi bi-mortarboard-fill text-primary"></i>
                            <strong>Class of:</strong> @item.GraduationYear
                        </div>

                        @if (!string.IsNullOrEmpty(item.PermanentEmail))
                        {
                            <div class="mb-2">
                                <i class="bi bi-envelope-fill text-success"></i>
                                <a href="mailto:@item.PermanentEmail">@item.PermanentEmail</a>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.Phone))
                        {
                            <div class="mb-2">
                                <i class="bi bi-telephone-fill text-info"></i>
                                @item.Phone
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.City) || !string.IsNullOrEmpty(item.State))
                        {
                            <div class="mb-2">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                @item.City@(!string.IsNullOrEmpty(item.City) && !string.IsNullOrEmpty(item.State) ? ", " : "")@item.State
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.SocialMediaAccount))
                        {
                            <div class="mb-2">
                                <i class="bi bi-share-fill text-warning"></i>
                                @item.SocialMediaAccount
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="Details" asp-route-id="@item.AlumniId" class="btn btn-sm btn-outline-primary w-100">
                            <i class="bi bi-eye"></i> View Profile
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Table View for Alumni Users (Hidden by default) -->
    <div class="table-responsive" id="tableView" style="display:none;">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>JAG ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Graduation Year</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle"></i> No alumni found.
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.JagId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Prefix))
                            {
                                <text>@item.Prefix </text>
                            }
                            @item.FirstName @item.LastName
                            @if (!string.IsNullOrEmpty(item.PreferredFirstName))
                            {
                                <br /><small class="text-info">(@item.PreferredFirstName)</small>
                            }
                        </td>
                        <td>@item.PermanentEmail</td>
                        <td>@item.Phone</td>
                        <td>@item.GraduationYear</td>
                        <td>@item.City@(!string.IsNullOrEmpty(item.City) && !string.IsNullOrEmpty(item.State) ? ", " : "")@item.State</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.AlumniId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <!-- Table View for Admin/Staff -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.JagId)</th>
                    <th>Name</th>
                    <th>@Html.DisplayNameFor(model => model.PermanentEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th>@Html.DisplayNameFor(model => model.GraduationYear)</th>
                    <th>@Html.DisplayNameFor(model => model.City)</th>
                    <th>@Html.DisplayNameFor(model => model.State)</th>
                    <th>Solicitation</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center">
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle"></i> No alumni found.
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.JagId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Prefix))
                            {
                                <text>@item.Prefix </text>
                            }
                            @item.FirstName @item.LastName
                            @if (!string.IsNullOrEmpty(item.PreferredFirstName))
                            {
                                <br /><small class="text-info">(@item.PreferredFirstName)</small>
                            }
                        </td>
                        <td>@item.PermanentEmail</td>
                        <td>@item.Phone</td>
                        <td>@item.GraduationYear</td>
                        <td>@item.City</td>
                        <td>@item.State</td>
                        <td>
                            @if (item.SolicitationCode)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> No</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.AlumniId" class="btn btn-sm btn-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.AlumniId" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.AlumniId" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
