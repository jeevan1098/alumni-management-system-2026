                        <div class="card-footer bg-transparent border-0">
                            <a asp-action="Details"
                               asp-route-id="@item.AlumniId"
                               class="btn btn-primary w-100">
                                <i class="bi bi-eye-fill text-white me-1"></i>
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>


@if (isAdmin)
{
    <form id="bulkDeleteForm" asp-action="BulkDelete" method="post"></form>

    <div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-labelledby="bulkDeleteTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="bulkDeleteTitle"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Delete selected alumni?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You're about to permanently delete <strong id="bulkModalCount">0</strong> alumni record(s), including their degrees, employment, internships, organizations and messages.</p>
                    <p class="mb-0">Their linked login accounts are deleted too, except accounts that also have the Admin or Staff role - those only lose the Alumni role. <strong>This can't be undone.</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="bulkDeleteForm" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-1"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Bulk delete (Admin only): tick rows, then "Delete selected". The
        // checkboxes post straight to #bulkDeleteForm via their form="" attribute.
        (function () {
            var selectAll = document.getElementById('selectAllAlumni');
            if (!selectAll) return;
            var boxes = Array.prototype.slice.call(document.querySelectorAll('.alumni-select'));
            var bar = document.getElementById('bulkBar');

            // "Shown" = not hidden by the table search (admin-enhance.js).
            function shownBoxes() {
                return boxes.filter(function (b) { return !b.closest('tr').classList.contains('ae-filtered'); });
            }

            function refresh() {
                var checked = boxes.filter(function (b) { return b.checked; }).length;
                var shown = shownBoxes();
                var shownChecked = shown.filter(function (b) { return b.checked; }).length;
                document.getElementById('bulkCount').textContent = checked;
                document.getElementById('bulkModalCount').textContent = checked;
                bar.classList.toggle('d-none', checked === 0);
                selectAll.checked = shown.length > 0 && shownChecked === shown.length;
                selectAll.indeterminate = shownChecked > 0 && shownChecked < shown.length;
                boxes.forEach(function (b) { b.closest('tr').classList.toggle('table-danger', b.checked); });
            }

            selectAll.addEventListener('change', function () {
                shownBoxes().forEach(function (b) { b.checked = selectAll.checked; });
                refresh();
            });
            boxes.forEach(function (b) { b.addEventListener('change', refresh); });
            document.getElementById('bulkClear').addEventListener('click', function () {
                boxes.forEach(function (b) { b.checked = false; });
                refresh();
            });
            // Keep the header checkbox in step as the table search hides rows.
            ['input', 'change'].forEach(function (type) {
                document.addEventListener(type, function (e) {
                    if (e.target.closest && e.target.closest('.ae-toolbar')) setTimeout(refresh, 0);
                });
            });
            refresh();
        })();

        function toggleView(viewType) {

            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');
            const cardBtn = document.getElementById('cardViewBtn');
            const tableBtn = document.getElementById('tableViewBtn');

            if (!cardView) return;

            if (viewType === 'card') {
                tableView.style.display = 'none';
                cardView.style.display = 'flex';
                cardBtn.classList.add('active');
                tableBtn.classList.remove('active');
            } else {
                tableView.style.display = 'block';
                cardView.style.display = 'none';
                tableBtn.classList.add('active');
                cardBtn.classList.remove('active');
            }
        }

        // Default = TABLE VIEW
        document.addEventListener('DOMContentLoaded', function () {
            toggleView('table');
        });
    </script>
}

