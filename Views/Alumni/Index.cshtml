                            {
                                <p class="mb-1"><span class="text-muted" title="This alumnus keeps their contact details private"><i class="bi bi-lock-fill me-1"></i>Private</span> contact details</p>
                            }
                            else
                            {
                                <p class="mb-1">
                                    <i class="bi bi-envelope-fill text-primary me-2"></i>
                                    @item.PermanentEmail
                                </p>

                                <p class="mb-1">
                                    <i class="bi bi-telephone-fill text-primary me-2"></i>
                                    @item.Phone
                                </p>
                            }

                            <p class="mb-0">
                                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                                @item.City, @item.State
