@model Alumni_Management_System.Models.Alumni
@using Microsoft.AspNetCore.Identity
@using Alumni_Management_System.Models
@inject UserManager<AppUser> UserManager

@{
    ViewData["Title"] = "Edit Profile";
    var currentUser = await UserManager.GetUserAsync(User);
    var isFirstLogin = currentUser?.IsFirstLogin ?? false;
    var userRole = ViewData["UserRole"]?.ToString();
    var isAdmin = userRole == "Admin";

    // Calculate profile completion
    int totalFields = 18;
    int completedFields = 0;

    if (!string.IsNullOrEmpty(Model.FirstName)) completedFields++;
    if (!string.IsNullOrEmpty(Model.LastName)) completedFields++;
    if (!string.IsNullOrEmpty(Model.PermanentEmail)) completedFields++;
    if (!string.IsNullOrEmpty(Model.Phone)) completedFields++;
    if (!string.IsNullOrEmpty(Model.Gender)) completedFields++;
    if (Model.DateOfBirth.HasValue) completedFields++;
    if (!string.IsNullOrEmpty(Model.Address)) completedFields++;
    if (!string.IsNullOrEmpty(Model.City)) completedFields++;
    if (!string.IsNullOrEmpty(Model.State)) completedFields++;
    if (!string.IsNullOrEmpty(Model.Postcode)) completedFields++;
    if (!string.IsNullOrEmpty(Model.Country)) completedFields++;
    if (Model.GraduationYear > 0) completedFields++;
    if (!string.IsNullOrEmpty(Model.PreferredFirstName)) completedFields++;
    if (!string.IsNullOrEmpty(Model.StudentEmail)) completedFields++;
    if (!string.IsNullOrEmpty(Model.SocialMediaAccount)) completedFields++;
    if (!string.IsNullOrEmpty(Model.Prefix)) completedFields++;
    if (Model.Privacy) completedFields++;
    if (Model.IsActive) completedFields++;

    int completionPercentage = (int)((double)completedFields / totalFields * 100);
}

@if (isFirstLogin)
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading"><i class="bi bi-info-circle"></i> Welcome! Complete Your Profile</h4>
        <p>Please fill in your profile information to get started. This helps other alumni connect with you.</p>
    </div>
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1><i class="bi bi-person-circle"></i> Edit Profile</h1>
        <p class="text-info">Update your alumni profile information</p>

        <!-- Profile Completion Progress -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-info">Profile Completion</h6>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar @(completionPercentage == 100 ? "bg-success" : "bg-primary")"
                         role="progressbar"
                         style="width: @completionPercentage%;"
                         aria-valuenow="@completionPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @completionPercentage% Complete
                    </div>
                </div>
                <small class="text-info mt-2 d-block">
                    @completedFields of @totalFields fields completed
                </small>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-10 mx-auto">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AlumniId" />
            <input type="hidden" asp-for="LastUpdated" />
            <input type="hidden" asp-for="IsActive" />

            <!-- Basic Information -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Basic Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="JagId" class="form-label"></label>
                            <input asp-for="JagId" class="form-control" placeholder="J0012345" readonly />
                            <span asp-validation-for="JagId" class="text-danger"></span>
                            <small class="form-text text-info"><i class="bi bi-lock"></i> JAG ID cannot be changed</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Prefix" class="form-label"></label>
                            <select asp-for="Prefix" class="form-select">
                                <option value="">Select...</option>
                                <option value="Mr.">Mr.</option>
                                <option value="Ms.">Ms.</option>
                                <option value="Mrs.">Mrs.</option>
                                <option value="Dr.">Dr.</option>
                                <option value="Prof.">Prof.</option>
                            </select>
                            <span asp-validation-for="Prefix" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" readonly />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                            <small class="form-text text-info"><i class="bi bi-lock"></i> From Registry</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PreferredFirstName" class="form-label"></label>
                            <input asp-for="PreferredFirstName" class="form-control" />
                            <span asp-validation-for="PreferredFirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" readonly />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                            <small class="form-text text-info"><i class="bi bi-lock"></i> From Registry</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MiddleName" class="form-label"></label>
                            <input asp-for="MiddleName" class="form-control" />
                            <span asp-validation-for="MiddleName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Suffix" class="form-label"></label>
                            <input asp-for="Suffix" class="form-control" placeholder="Jr., Sr., III" />
                            <span asp-validation-for="Suffix" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GraduationYear" class="form-label"></label>
                            @if (isAdmin)
                            {
                                <input asp-for="GraduationYear" class="form-control" type="number" min="1950" max="2100" />
                            }
                            else
                            {
                                <input asp-for="GraduationYear" class="form-control" type="number" readonly />
                                <small class="form-text text-info"><i class="bi bi-lock"></i> From Registry</small>
                            }
                            <span asp-validation-for="GraduationYear" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CollegeId" class="form-label"></label>
                            <select asp-for="CollegeId" class="form-select" asp-items="ViewBag.CollegeId">
                                <option value="">Select College...</option>
                            </select>
                            <span asp-validation-for="CollegeId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colleges & Departments (from earned degrees - view only,
                 since a person can hold several, unlike the single College
                 field above) -->
            @{ var degreeColleges = ViewData["DegreeColleges"] as List<Alumni_Management_System.Models.ViewModels.AlumniDegreeCollegeViewModel>; }
            @if (degreeColleges != null && degreeColleges.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-bank2"></i> My Colleges &amp; Departments</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Based on your degrees on file - view only.</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <thead>
                                    <tr class="text-muted small text-uppercase">
                                        <th>Degree</th>
                                        <th>College</th>
                                        <th>Department</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dc in degreeColleges)
                                    {
                                        <tr>
                                            <td>@dc.DegreeType, @dc.MajorFieldOfStudy</td>
                                            <td><span class="badge bg-info-subtle text-info-emphasis">@dc.CollegeName</span></td>
                                            <td><span class="badge bg-light text-dark border">@dc.DepartmentName</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Contact Information -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-envelope"></i> Contact Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StudentEmail" class="form-label"></label>
                            <input asp-for="StudentEmail" class="form-control" type="email" />
                            <span asp-validation-for="StudentEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PermanentEmail" class="form-label"></label>
                            <input asp-for="PermanentEmail" class="form-control" type="email" />
                            <span asp-validation-for="PermanentEmail" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" type="tel" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SocialMediaAccount" class="form-label"></label>
                            <input asp-for="SocialMediaAccount" class="form-control" placeholder="LinkedIn, Twitter, etc." />
                            <span asp-validation-for="SocialMediaAccount" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Address Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" placeholder="Street Address" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Postcode" class="form-label"></label>
                            <input asp-for="Postcode" class="form-control" />
                            <span asp-validation-for="Postcode" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Privacy Settings -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Privacy Settings</h5>
                </div>
                @if (isAdmin)
                {
                    <!-- Status (Admin only) -->
                    <div class="card-body">
                        <label class="form-label fw-semibold">&nbsp;</label>
                        <div class="form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input me-2 border-primary" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                }
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="SolicitationCode" />
                        <label class="form-check-label" asp-for="SolicitationCode">
                            @Html.DisplayNameFor(model => model.SolicitationCode)
                        </label>
                        <div class="form-text">
                            <i class="bi bi-envelope me-1"></i>@Alumni_Management_System.Models.Alumni.SolicitationHelp
                        </div>
                        <span asp-validation-for="SolicitationCode" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="Privacy" />
                        <label class="form-check-label" asp-for="Privacy">
                            @Html.DisplayNameFor(model => model.Privacy)
                        </label>
                        <div class="form-text">
                            <i class="bi bi-lock me-1"></i>@Alumni_Management_System.Models.Alumni.PrivacyHelp
                        </div>
                        <span asp-validation-for="Privacy" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-between mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Directory
                </a>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Profile
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
