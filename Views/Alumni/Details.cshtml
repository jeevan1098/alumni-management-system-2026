@model Alumni_Management_System.Models.Alumni

@{
    ViewData["Title"] = "Alumni Profile";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">

            <!-- Header Section -->
            <div class="row align-items-center mb-4">
                <div class="col-md-3 text-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto"
                         style="width:120px;height:120px;font-size:40px;">
                        @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                    </div>
                </div>

                <div class="col-md-9">
                    <h2 class="fw-bold mb-0">
                        @Model.Prefix @Model.FirstName @Model.LastName
                    </h2>

                    @if (!string.IsNullOrEmpty(Model.PreferredFirstName))
                    {
                        <p class="text-info mb-1">
                            Preferred Name: <strong>@Model.PreferredFirstName</strong>
                        </p>
                    }

                    <p class="mb-1">
                        🎓 Class of <strong>@Model.GraduationYear</strong>
                    </p>

                    <p class="mb-0 text-info">
                        📍 @Model.City, @Model.State, @Model.Country
                    </p>
                </div>
            </div>

            <hr />

            <!-- Contact Section -->
            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <h5 class="fw-bold">Contact Information</h5>

                    @if (!string.IsNullOrEmpty(Model.StudentEmail))
                    {
                        <p class="mb-1">📧 Student Email: @Model.StudentEmail</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.PermanentEmail))
                    {
                        <p class="mb-1">📧 Current Email: @Model.PermanentEmail</p>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <p class="mb-1">📱 Phone: @Model.Phone</p>
                        }
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <h5 class="fw-bold">Personal Details</h5>

                @if (User.IsInRole("Admin"))
                {
                        @if (Model.AgeAtGraduation.HasValue)
                        {
                            <p class="mb-1">🎓 Age at Graduation: @Model.AgeAtGraduation years</p>
                        }

                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <p class="mb-1">🏠 Address: @Model.Address</p>
                        }
                    }

                    @if (!string.IsNullOrEmpty(Model.SocialMediaAccount))
                    {
                        <p class="mb-1">
                            🌐 Social Media:
                            <a href="@Model.SocialMediaAccount" target="_blank">View Profile</a>
                        </p>
                    }
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <hr />
                <!-- Settings & Status Section -->
                <div class="mt-4">
                    <h5 class="fw-bold mb-3">Profile Settings & Status</h5>

                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1">
                                📩 Solicitation Code:
                                <span class="badge bg-info text-dark">@Model.SolicitationCode</span>
                            </p>
                            <p class="mb-1">
                                🔒 Privacy Level:
                                <span class="badge bg-secondary">@Model.Privacy</span>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p class="mb-1">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </p>
                            <p class="mb-1">
                                🕒 Last Updated: @Model.LastUpdated.ToString("MMMM dd, yyyy hh:mm tt")
                            </p>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Footer — Edit Profile hidden from Staff -->
        <div class="card-footer bg-light d-flex justify-content-between rounded-bottom-4">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.AlumniId"
                   class="btn btn-primary rounded-pill px-4">
                    Edit Profile
                </a>
            }

            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                Back to List
            </a>
        </div>
    </div>
</div>
