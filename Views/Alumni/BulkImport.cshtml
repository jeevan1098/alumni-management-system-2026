@{
    ViewData["Title"] = "Bulk Import Alumni";
}
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Html.Raw(TempData["SuccessMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @Html.Raw(TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ImportErrors"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <pre>@Html.Raw(TempData["ImportErrors"])</pre>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:900px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-upload text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Bulk Import Alumni</h3>
                    <small class="text-info">Upload Excel files to import Alumni + AlumniDegree + AlumniRegistry</small>
                </div>
            </div>

            <hr class="mb-4" />


            <form asp-action="BulkImport" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label for="excelFile" class="form-label fw-semibold"><span class="text-danger">*</span> Select Excel File</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-file-earmark-arrow-up-fill"></i></span>
                        <input type="file" class="form-control rounded-end-3" id="excelFile" name="excelFile" accept=".xlsx,.xls" required />
                    </div>
                    <div class="form-text">Supported formats: Excel (.xlsx, .xls)</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-upload me-2"></i>Upload and Import
                    </button>
                </div>
            </form>

            <div class="card mt-5 border-0 shadow-sm">
                <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary">
                    File Format Instructions
                </div>
                <div class="card-body">
                    <p><strong>Column order does NOT matter!</strong> Fields will be matched by their header names (case-insensitive).</p>
                    
                    <p>The Excel file should have the following columns (in any order):</p>
                    <ol>
                        <li><strong>JagId</strong> (Required, format: J + digits, e.g., J012345)</li>
                        <li><strong>Name Prefix</strong> (e.g., Mr., Ms., Dr.)</li>
                        <li><strong>First Name</strong></li>
                        <li><strong>Preferred First Name</strong></li>
                        <li><strong>Last Name</strong></li>
                        <li><strong>Gender</strong></li>
                        <li><strong>Age At Graduation</strong> (numerical)</li>
                        <li><strong>Student Email</strong></li>
                        <li><strong>Permanent Email</strong></li>
                        <li><strong>Phone</strong></li>
                        <li><strong>Address</strong></li>
                        <li><strong>City</strong></li>
                        <li><strong>State</strong></li>
                        <li><strong>Postcode</strong></li>
                        <li><strong>Country</strong></li>
                        <li><strong>GraduationYear</strong> (numerical, e.g., 2020)</li>
                        <li><strong>DegreeType</strong> (e.g., Bachelor's, Master's, PhD)</li>
                        <li><strong>Major</strong> (e.g., Computer Science, Business Administration)</li>
                        <li><strong>DegreeProgram</strong> (name of the degree program)</li>
                        <li><strong>Education Institution</strong> (university or college name)</li>
                        <li><strong>GPA</strong> (numerical, e.g., 3.75 or 4.0)</li>
                    </ol>

                    <div class="alert alert-info">
                        <strong>Important:</strong> 
                        <ul>
                            <li>Each JagId must be unique and cannot be duplicated in Alumni or AlumniRegistry tables.</li>
                            <li>Headers are case-insensitive (e.g., "jagid" or "JagID" will both work).</li>
                            <li>Duplicate entries will be rejected with an error message.</li>
                        </ul>
                    </div>

                    <div class="mt-3">
                        <strong>Sample Excel Structure (columns can be in any order):</strong>
                        <table class="table table-bordered table-sm mt-2">
                            <thead class="table-light">
                                <tr>
                                    <th>JagId</th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Permanent Email</th>
                                    <th>DegreeType</th>
                                    <th>Major</th>
                                    <th>GraduationYear</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>J12345</td>
                                    <td>John</td>
                                    <td>Doe</td>
                                    <td>john@example.com</td>
                                    <td>Bachelor's</td>
                                    <td>Computer Science</td>
                                    <td>2020</td>
                                </tr>
                                <tr>
                                    <td>J012346</td>
                                    <td>Jane</td>
                                    <td>Smith</td>
                                    <td>jane@example.com</td>
                                    <td>Master's</td>
                                    <td>Business</td>
                                    <td>2021</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
