
@model Alumni_Management_System.Models.AlumniOrganization

@{
    ViewData["Title"] = "Add Student Organization";
    var userRole = ViewData["UserRole"]?.ToString();
    var currentAlumniId = ViewData["CurrentAlumniId"] as int?;
    var isAdmin = userRole == "Admin";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-building text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Add Student Organization</h3>
                    <small class="text-info">Enter organization and role information for alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Create" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Alumni & Organization -->
                <div class="mb-4">
                    <label class="form-label fw-semibold"><span class="text-danger">*</span> Alumni</label>
                    <div class="input-group shadow-sm mb-3">
                        <span class="input-group-text bg-light"><i class="bi bi-person-fill"></i></span>
                        @if (isAdmin)
                        {
                            <select asp-for="AlumniId" class="form-select rounded-end-3" asp-items="ViewBag.AlumniId">
                                <option value="">-- Select an Alumni --</option>
                            </select>
                        }
                        else
                        {
                            <select asp-for="AlumniId" class="form-select rounded-end-3" asp-items="ViewBag.AlumniId" disabled></select>
                            <input type="hidden" asp-for="AlumniId" value="@currentAlumniId" />
                        }
                    </div>
                    <span asp-validation-for="AlumniId" class="text-danger"></span>

                    <label class="form-label fw-semibold"><span class="text-danger">*</span> Organization Type</label>
                    <div class="input-group shadow-sm mb-3">
                        <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                        <select asp-for="OrganizationTypeId" class="form-select rounded-end-3" asp-items="ViewBag.OrganizationTypeId">
                            <option value="">-- Select Organization Type --</option>
                        </select>
                    </div>
                    <span asp-validation-for="OrganizationTypeId" class="text-danger"></span>

                    <div class="mb-3">
                        <label asp-for="OfficerRoles" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Officer Role
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                            <select asp-for="OfficerRoles" class="form-select rounded-end-3">
                                <option value="">-- Select Highest Officer Role --</option>
                                <option value="President">President</option>
                                <option value="Vice President">Vice President</option>
                                <option value="Secretary">Secretary</option>
                                <option value="Treasurer">Treasurer</option>
                                <option value="Officer">Officer</option>
                                <option value="Member">Member</option>
                            </select>
                        </div>
                        <small class="form-text text-info">Select the highest-ranking officer role held.</small>
                        <span asp-validation-for="OfficerRoles" class="text-danger"></span>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Organization
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
