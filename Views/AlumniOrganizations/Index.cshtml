@model IEnumerable<Alumni_Management_System.Models.AlumniOrganization>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OfficerRoles)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alumni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrganizationType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.OfficerRoles)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alumni.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrganizationType.OrganizationName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AlumniOrganizationId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AlumniOrganizationId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AlumniOrganizationId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
