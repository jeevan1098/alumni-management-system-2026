@model IEnumerable<Alumni_Management_System.Models.AlumniOrganization>

@{
    ViewData["Title"] = "Student Organizations";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Student Organizations</h3>
                    <small class="text-info">List of alumni and their organization roles</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Index" method="get" class="mb-4 row g-3">
                <input type="hidden" name="sortOrder" value="@ViewData["SortOrder"]" />
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Search by name, JAG ID, organization or role..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Search</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 btn-lg">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </a>
                </div>
            </form>

            <!-- Add New Button -->
            <div class="d-flex justify-content-end mb-3">
                @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-circle-fill me-2"></i>Add Organization
                    </a>
                }
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-center">
                        @{
                            var sortOrder = ViewData["SortOrder"]?.ToString() ?? "";
                            var search = ViewData["CurrentFilter"]?.ToString() ?? "";
                        }
                        <tr>
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "role" ? "role_desc" : "role", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-person-badge me-1 text-primary"></i>Officer Role
                                    @if (sortOrder == "role")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "role_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "name" ? "name_desc" : "name", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-person-fill me-1 text-primary"></i>Alumni
                                    @if (sortOrder == "name")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "name_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { sortOrder = sortOrder == "org" ? "org_desc" : "org", searchString = search })" class="text-white text-decoration-none">
                                    <i class="bi bi-building me-1 text-primary"></i>Organization Type
                                    @if (sortOrder == "org")
                                    {
                                        <span>▲</span>
                                    }
                                    else if (sortOrder == "org_desc")
                                    {
                                        <span>▼</span>
                                    }
                                </a>
                            </th>
                            <th><i class="bi bi-list-task me-2 text-primary"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="text-center">
                                <td>@item.OfficerRoles</td>
                                <td>@item.Alumni.FirstName @item.Alumni.LastName</td>
                                <td>@item.OrganizationType.OrganizationName</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-warning rounded-pill">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Footer -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>