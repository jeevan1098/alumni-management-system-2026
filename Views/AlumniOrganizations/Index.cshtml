
@model IEnumerable<Alumni_Management_System.Models.AlumniOrganization>

@{
    ViewData["Title"] = "Student Organizations";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Student Organizations</h3>
                    <small class="text-info">List of alumni and their organization roles</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Add New Button -->
            <div class="d-flex justify-content-end mb-3">
                @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-circle-fill me-2"></i>Add Organization
                    </a>
                }
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th><i class="bi bi-person-badge me-1 text-primary"></i>Officer Role</th>
                            <th><i class="bi bi-person-fill me-1 text-primary"></i>Alumni</th>
                            <th><i class="bi bi-building me-1 text-primary"></i>Organization Type</th>
                            <th><i class="bi bi-list-task me-2 text-primary"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="text-center">
                                <td>@item.OfficerRoles</td>
                                <td>@item.Alumni.FirstName @item.Alumni.LastName</td>
                                <td>@item.OrganizationType.OrganizationName</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Alumni"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-warning rounded-pill">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.AlumniOrganizationId" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Footer -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>