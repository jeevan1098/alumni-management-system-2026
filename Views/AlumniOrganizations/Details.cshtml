@model Alumni_Management_System.Models.AlumniOrganization

@{
    ViewData["Title"] = "Organization Details";
    var alumniName = Model.Alumni != null
        ? $"{(!string.IsNullOrEmpty(Model.Alumni.PreferredFirstName) ? Model.Alumni.PreferredFirstName : Model.Alumni.FirstName)} {Model.Alumni.LastName}"
        : "Unknown Alumni";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-building-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Organization Details of <span class="text-primary">@alumniName</span>
                    </h3>
                    <small class="text-info">View organization information for this alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="row g-4">
                <!-- Alumni Info -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-person-badge-fill me-2"></i>Alumni Information
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">Alumni</dt>
                        <dd class="col-sm-7">@alumniName</dd>
                    </dl>
                </div>

                <!-- Organization Info -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-briefcase-fill me-2"></i>Organization Information
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">Organization Type</dt>
                        <dd class="col-sm-7">
                            @if (Model.OrganizationType != null && !string.IsNullOrEmpty(Model.OrganizationType.OrganizationName))
                            {
                                @Model.OrganizationType.OrganizationName
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Officer Roles</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.OfficerRoles))
                            {
                                @Model.OfficerRoles
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.AlumniOrganizationId" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            </div>

        </div>
    </div>
</div>