

@model Alumni_Management_System.Models.AlumniOrganization

@{
    ViewData["Title"] = "Edit Student Organization";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-people-fill text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">Edit Student Organization</h3>
                    <small class="text-info text-warning">
                        Update student organization involvement
                    </small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="AlumniOrganizationId" />

                <!-- Alumni & Organization Section -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-person-badge-fill me-2 text-warning"></i>
                    Alumni & Organization Information
                </h5>

                <div class="row mb-4">

                    <!-- Alumni -->
                    <div class="col-md-6">
                        <label asp-for="AlumniId" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Alumni Name
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-fill text-warning"></i>
                            </span>
                            <select asp-for="AlumniId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.AlumniId">
                            </select>
                        </div>
                        <span asp-validation-for="AlumniId" class="text-danger small"></span>
                    </div>

                    <!-- Organization Type -->
                    <div class="col-md-6">
                        <label asp-for="OrganizationTypeId" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Organization Type
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-building text-warning"></i>
                            </span>
                            <select asp-for="OrganizationTypeId"
                                    class="form-select rounded-end-3"
                                    asp-items="ViewBag.OrganizationTypeId">
                                <option value="">-- Select Organization Type --</option>
                            </select>
                        </div>
                        <span asp-validation-for="OrganizationTypeId" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Officer Role Section -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-award-fill me-2 text-warning"></i>
                    Officer Role
                </h5>

                <div class="mb-4">
                    <label asp-for="OfficerRoles" class="form-label fw-semibold">
                        <span class="text-danger">*</span> Highest Officer Role
                    </label>

                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-person-badge text-warning"></i>
                        </span>
                        <select asp-for="OfficerRoles"
                                class="form-select rounded-end-3">
                            <option value="">-- Select Highest Officer Role --</option>
                            <option value="President">President</option>
                            <option value="Vice President">Vice President</option>
                            <option value="Secretary">Secretary</option>
                            <option value="Treasurer">Treasurer</option>
                            <option value="Officer">Officer</option>
                            <option value="Member">Member</option>
                        </select>
                    </div>

                    <small class="text-info">
                        Select the highest-ranking officer role held.
                    </small>
                    <span asp-validation-for="OfficerRoles" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill text-white me-2"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}