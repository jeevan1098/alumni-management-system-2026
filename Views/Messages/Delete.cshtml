@model Alumni_Management_System.Models.Message

@{
    ViewData["Title"] = "Delete Message";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-trash-fill text-danger fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Delete Message: <span class="text-primary">@Model.Title</span>
                    </h3>
                    <small class="text-info">Are you sure you want to permanently delete this message?</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Message Details -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-envelope-fill me-2 text-danger"></i>Message Details
            </h5>
            <dl class="row mb-4">
                <dt class="col-md-3 fw-semibold"><i class="bi bi-chat-text me-2 text-danger"></i>Title</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-md-3 fw-semibold"><i class="bi bi-card-text me-2 text-danger"></i>Message Body</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.MessageBody)</dd>

                <dt class="col-md-3 fw-semibold"><i class="bi bi-tag-fill me-2 text-danger"></i>Message Type</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.MessageType)</dd>

                <dt class="col-md-3 fw-semibold"><i class="bi bi-calendar-event-fill me-2 text-danger"></i>Created At</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.CreatedAt)</dd>

                <dt class="col-md-3 fw-semibold"><i class="bi bi-person-fill me-2 text-danger"></i>Created By</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.CreatedByNavigation.Id)</dd>
            </dl>

            <!-- Delete Confirmation Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="MessageId" />
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>