@model IEnumerable<Alumni_Management_System.Models.Message>

@{
    ViewData["Title"] = "Messages";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-envelope-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Messages</h3>
                    <small class="text-info">Manage messages sent to alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Add New Button -->
            <div class="d-flex justify-content-end mb-3">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-circle-fill me-2"></i>Create New
                </a>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="bi bi-card-text me-1 text-primary"></i>Title</th>
                            <th><i class="bi bi-chat-left-text me-1 text-primary"></i>Message</th>
                            <th><i class="bi bi-info-circle-fill me-1 text-primary"></i>Type</th>
                            <th><i class="bi bi-calendar-event me-1 text-primary"></i>Created At</th>
                            <th><i class="bi bi-person-fill me-1 text-primary"></i>Created By</th>
                            <th><i class="bi bi-list-task me-2 text-primary"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(m => m.CreatedAt))
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.MessageBody</td>
                                <td>@item.MessageType</td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@item.CreatedByNavigation.UserName</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.MessageId" class="btn btn-sm btn-outline-primary rounded-pill me-2">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MessageId" class="btn btn-sm btn-outline-warning rounded-pill me-2">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MessageId" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Footer -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
