

@model Alumni_Management_System.Models.Message

@{
    ViewData["Title"] = "Message Details";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-chat-dots-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Message Details
                    </h3>
                    <small class="text-info">
                        View complete message information
                    </small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="row g-4">

                <!-- Message Content -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-envelope-fill me-2"></i>Message Content
                    </h5>

                    <dl class="row">
                        <dt class="col-sm-5">Title</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(Model.Title))
                            {
                                @Model.Title
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Message Body</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(Model.MessageBody))
                            {
                                @Model.MessageBody
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Message Type</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(Model.MessageType))
                            {
                                <span class="badge bg-primary">
                                    @Model.MessageType
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Metadata -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-person-badge-fill me-2"></i>Metadata
                    </h5>

                    <dl class="row">
                        <dt class="col-sm-5">Created At</dt>
                        <dd class="col-sm-7">
                            @Model.CreatedAt
                        </dd>

                        <dt class="col-sm-5">Created By</dt>
                        <dd class="col-sm-7">
                            @if (Model.CreatedByNavigation != null)
                            {
                                <span class="badge bg-info text-dark">
                                    @Model.CreatedByNavigation.UserName
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>
                    </dl>
                </div>

            </div>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>

                <a asp-action="Edit" asp-route-id="@Model?.MessageId"
                   class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            </div>

        </div>
    </div>
</div>