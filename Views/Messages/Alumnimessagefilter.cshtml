@model IEnumerable<Alumni_Management_System.Models.ViewModels.AlumniMailingViewmodel>

@{
   
    var list = Model.ToList();
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2>Alumni Message Filter (Email Campaign)</h2>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 col-lg-5">

            <label for="globalSearch" class="form-label fw-bold text-secondary mb-2">
                <i class="bi bi-filter-left me-1"></i> Quick Search
            </label>

            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text"
                       id="globalSearch"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search (e.g. John, IT, 2024, MS)"
                       aria-label="Search through records">
                <button class="btn btn-primary" type="button" id="button-search">
                    Search
                </button>
            </div>

            <div class="form-text mt-2">
                Use keywords like name, degree, or year.
            </div>

        </div>
    </div>
</div>

<!-- 🔢 COUNT -->
<div style="margin-bottom:10px; font-weight:bold;">
    Results Found: <span id="resultCount">0</span>
</div>

<form asp-action="SaveSelectedAlumniMessage" method="post">

    <!-- ✅ MESSAGE ID -->
    <input type="hidden" name="MessageId" value="@ViewBag.MessageId" />

    <table class="table table-bordered" id="alumniTable">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" id="selectAll" />
                </th>
                <th>Name</th>
                <th>Email</th>
                <th>Graduation Year</th>
                <th>Degree</th>
                <th>Degree Type</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < list.Count; i++)
            {
                <tr class="@(list[i].IsAlreadyMapped ? "table-secondary" : "")">

                    <td>
                        <!--  CHECKBOX (MODEL BINDING FIXED) -->
                        <input type="checkbox"
                               name="model[@i].IsSelected"
                               value="true"
                               @(list[i].IsSelected ? "checked" : "")
                               @(list[i].IsAlreadyMapped ? "disabled" : "") />

                        <!-- required for unchecked -->
                        <input type="hidden" name="model[@i].IsSelected" value="false" />

                        <!-- DATA -->
                        <input type="hidden" name="model[@i].AlumniId" value="@list[i].AlumniId" />
                        <input type="hidden" name="model[@i].PermanentEmail" value="@list[i].PermanentEmail" />

                        <!-- maintain already mapped flag -->
                        <input type="hidden" name="model[@i].IsAlreadyMapped" value="@list[i].IsAlreadyMapped" />
                    </td>

                    <td class="name">
                        @list[i].FirstName @list[i].LastName
                    </td>

                    <td class="email">
                        @list[i].PermanentEmail
                    </td>

                    <td class="year">
                        @list[i].GraduationYear
                    </td>

                    <td class="degree">
                        @list[i].Degree
                    </td>

                    <td class="degreetype">
                        @list[i].DegreeType
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>Send Mail
        </button>
    </div>

</form>

<!-- ================= SCRIPT ================= -->
<script>
    function filterTable() {

        let input = document.getElementById("globalSearch").value.toLowerCase();

        let filters = input.split(",")
                           .map(x => x.trim())
                           .filter(x => x.length > 0);

        let rows = document.querySelectorAll("#alumniTable tbody tr");

        let visibleCount = 0;

        rows.forEach(row => {

            let text = (
                row.querySelector(".name").innerText + " " +
                row.querySelector(".email").innerText + " " +
                row.querySelector(".year").innerText + " " +
                row.querySelector(".degree").innerText + " " +
                row.querySelector(".degreetype").innerText
            ).toLowerCase();

            let show = filters.every(f => text.includes(f));

            row.style.display = show ? "" : "none";

            if (show) visibleCount++;
        });

        document.getElementById("resultCount").innerText = visibleCount;
    }


    // SEARCH EVENT
    document.getElementById("globalSearch").addEventListener("keyup", filterTable);


    // SELECT ALL (only visible + not disabled)
    document.getElementById("selectAll").addEventListener("change", function () {

        let checkboxes = document.querySelectorAll("#alumniTable tbody input[type='checkbox']");

        checkboxes.forEach(cb => {

            let row = cb.closest("tr");

            if (row.style.display !== "none" && !cb.disabled) {
                cb.checked = this.checked;
            }
        });
    });


    // INITIAL COUNT
    window.onload = function () {
        let totalRows = document.querySelectorAll("#alumniTable tbody tr").length;
        document.getElementById("resultCount").innerText = totalRows;
    };


</script>