@{
    ViewData["Title"] = "Reports Dashboard";
}

<style>
    .reports-page {
        padding-bottom: 40px;
    }

    .reports-header {
        background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
        color: white;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0, 51, 102, 0.25);
    }

    .reports-header h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .reports-header p {
        margin-bottom: 0;
        opacity: 0.9;
    }

    .report-card {
        background: white;
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        padding: 26px;
        height: 100%;
        transition: all 0.2s ease;
    }

    .report-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 32px rgba(0,0,0,0.12);
    }

    .report-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(0,102,204,0.10);
        color: #0066cc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 18px;
    }

    .report-title {
        font-size: 20px;
        font-weight: 700;
        color: #003366;
        margin-bottom: 10px;
    }

    .report-desc {
        color: #555;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 22px;
        min-height: 68px;
    }

    .report-meta {
        background: #f5f8fc;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #555;
    }

    .report-meta i {
        color: #0066cc;
        margin-right: 6px;
    }

    .btn-report {
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .home-btn {
        border-radius: 50px;
        padding: 10px 22px;
    }
</style>

<div class="container reports-page mt-4">

    <!-- Page Header -->
    <div class="reports-header">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <i class="bi bi-bar-chart-fill fs-1"></i>
            </div>
            <div>
                <h2>Reports Dashboard</h2>
                <p>Generate alumni reports, view summaries, and download report data as Excel files.</p>
            </div>
        </div>
    </div>

    <!-- Report Cards -->
    <div class="row g-4">

        <!-- Mailing Labels -->
        <div class="col-lg-4 col-md-6">
            <div class="report-card">
                <div class="report-icon">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>

                <div class="report-title">Mailing Labels Report</div>

                <div class="report-desc">
                    Generate alumni mailing label information including name, address, city, state, and postcode.
                </div>

                <div class="report-meta">
                    <div><i class="bi bi-funnel-fill"></i>Filters available: Major, Degree Type, Year</div>
                    <div><i class="bi bi-file-earmark-excel-fill"></i>Excel download supported</div>
                </div>

                <a asp-controller="Reports" asp-action="MailingLabels"
                   class="btn btn-primary btn-report w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>Open Report
                </a>
            </div>
        </div>

        <!-- Alumni Count -->
        <div class="col-lg-4 col-md-6">
            <div class="report-card">
                <div class="report-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="report-title">Alumni Count Report</div>

                <div class="report-desc">
                    View alumni counts grouped by year, department, degree type, and major.
                </div>

                <div class="report-meta">
                    <div><i class="bi bi-funnel-fill"></i>Filters available: From Year, To Year, Group By</div>
                    <div><i class="bi bi-file-earmark-excel-fill"></i>Excel download supported</div>
                </div>

                <a asp-controller="Reports" asp-action="AlumniCount"
                   class="btn btn-primary btn-report w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>Open Report
                </a>
            </div>
        </div>

        <!-- Average GPA -->
        <div class="col-lg-4 col-md-6">
            <div class="report-card">
                <div class="report-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div class="report-title">Average GPA Report</div>

                <div class="report-desc">
                    Analyze average GPA values grouped by year, degree type, and major field of study.
                </div>

                <div class="report-meta">
                    <div><i class="bi bi-funnel-fill"></i>Filters available: From Year, To Year</div>
                    <div><i class="bi bi-file-earmark-excel-fill"></i>Excel download supported</div>
                </div>

                <a asp-controller="Reports" asp-action="AverageGPA"
                   class="btn btn-primary btn-report w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>Open Report
                </a>
            </div>
        </div>

    </div>

    <!-- Footer Navigation -->
    <div class="d-flex justify-content-between mt-5">
        <a asp-action="Index" asp-controller="Home"
           class="btn btn-outline-primary home-btn">
            <i class="bi bi-house-fill me-2"></i>Home
        </a>
    </div>

</div>