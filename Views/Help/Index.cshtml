@using Alumni_Management_System.Services
@inject SiteContentStore SiteContentStore
@inject SiteContentRenderer SiteContent
@{
    ViewData["Title"] = "Help & Support";
    var help = SiteContent.RenderHelp(SiteContentStore.Get(SiteContentDefinitions.HelpPage).Body);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <h2 class="mb-0">
            <i class="bi bi-question-circle-fill"></i>
            Help & Support Center
        </h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="SiteContent" asp-action="Edit" asp-route-id="@SiteContentDefinitions.HelpPage"
               asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-outline-secondary rounded-pill">
                <i class="bi bi-pencil-square me-1"></i>Edit this page
            </a>
        }
    </div>

    <partial name="_StatusMessages" />

    @if (!string.IsNullOrWhiteSpace(help.Intro.Value))
    {
        <div class="alert alert-info site-content">
            @help.Intro
        </div>
    }

    <!-- FAQ: one item per "## " heading in the Help content -->
    <div class="accordion" id="helpAccordion">
        @for (var i = 0; i < help.Sections.Count; i++)
        {
            var item = help.Sections[i];
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(i == 0 ? "" : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#q@(i + 1)">
                        @item.Question
                    </button>
                </h2>
                <div id="q@(i + 1)" class="accordion-collapse collapse @(i == 0 ? "show" : "")">
                    <div class="accordion-body site-content">
                        @item.Answer
                    </div>
                </div>
            </div>
        }
    </div>

</div>
