@model Alumni_Management_System.Models.AlumniRegistry

@{
    ViewData["Title"] = "Add Alumni Registry";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Add Alumni Registry</h3>
                    <small class="text-info">Enter alumni personal information</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Create" novalidate enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- JAG ID -->
                <div class="mb-3">
                    <label asp-for="JagId" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-card-text"></i>
                        </span>
                        <input asp-for="JagId" class="form-control rounded-end-3" placeholder="J0012345" />
                    </div>
                    <span asp-validation-for="JagId" class="text-danger"></span>
                    <small class="form-text text-info">Must start with 'J00' followed by numbers (e.g., J0012345)</small>
                </div>

                <!-- First Name -->
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <input asp-for="FirstName" class="form-control rounded-end-3" />
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <!-- Last Name -->
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <input asp-for="LastName" class="form-control rounded-end-3" />
                    </div>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <!-- Graduation Year -->
                <div class="mb-3">
                    <label asp-for="GraduationYear" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-calendar-event-fill"></i>
                        </span>
                        <input asp-for="GraduationYear" type="number" min="1900" max="2050" class="form-control rounded-end-3" placeholder="e.g. 2023" />
                    </div>
                    <span asp-validation-for="GraduationYear" class="text-danger"></span>
                </div>


                <!-- Degree Program -->
                <div class="mb-3">
                    <label asp-for="DegreeProgram" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-book-fill"></i>
                        </span>
                        <input asp-for="DegreeProgram" class="form-control rounded-end-3" />
                    </div>
                    <span asp-validation-for="DegreeProgram" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="EmailOnRecord" class="form-label fw-semibold"></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-envelope-fill"></i>
                        </span>
                        <input asp-for="EmailOnRecord" type="email" class="form-control rounded-end-3" />
                    </div>
                    <span asp-validation-for="EmailOnRecord" class="text-danger"></span>
                </div>

                <!-- Account Created -->
                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="AccountCreated" disabled/>
                    <label class="form-check-label fw-semibold">@Html.DisplayNameFor(model => model.AccountCreated)</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Alumni
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
