

@model Alumni_Management_System.Models.AlumniRegistry

@{
    ViewData["Title"] = "Edit Alumni Registry";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-person-vcard-fill text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">Edit Alumni Registry</h3>
                    <small class="text-info text-warning">
                        Update alumni record details
                    </small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="RegistryId" />

                <!-- Identity Section -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-person-fill me-2 text-warning"></i>
                    Identity Information
                </h5>

                <div class="row mb-4">

                    <!-- Jag ID -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="JagId" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-hash text-warning"></i>
                            </span>
                            <input asp-for="JagId"
                                   class="form-control rounded-end-3"
                                   placeholder="J0012345" />
                        </div>
                        <small class="text-info">
                            Must start with 'J00' followed by numbers (e.g., J0012345)
                        </small>
                        <span asp-validation-for="JagId" class="text-danger small"></span>
                    </div>

                    <!-- First Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person text-warning"></i>
                            </span>
                            <input asp-for="FirstName"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <!-- Last Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-badge text-warning"></i>
                            </span>
                            <input asp-for="LastName"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Account Status -->
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-shield-check me-2 text-warning"></i>
                    Account Status
                </h5>

                <div class="form-check mb-4">
                    <input class="form-check-input"
                           asp-for="AccountCreated"
                           disabled />
                    <label class="form-check-label fw-semibold">
                        @Html.DisplayNameFor(model => model.AccountCreated)
                    </label>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill text-white me-2"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}