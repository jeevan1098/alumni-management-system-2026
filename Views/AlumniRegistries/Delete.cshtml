@model Alumni_Management_System.Models.AlumniRegistry

@{
    ViewData["Title"] = "Delete Alumni Registry";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-trash-fill text-danger fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Delete Alumni Registry of <span class="text-primary">@Model.FirstName @Model.LastName</span>
                    </h3>
                    <small class="text-info">Are you sure you want to permanently delete this record?</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Personal & Academic Info -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-person-fill me-2 text-danger"></i>Personal & Academic Information
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="bi bi-card-text me-1"></i>JAG ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.JagId)</dd>

                <dt class="col-sm-3"><i class="bi bi-person me-1"></i>First Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>

                <dt class="col-sm-3"><i class="bi bi-person me-1"></i>Last Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>

                <dt class="col-sm-3"><i class="bi bi-calendar-check me-1"></i>Account Created</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AccountCreated)</dd>
            </dl>

            <!-- Delete Confirmation Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="RegistryId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>