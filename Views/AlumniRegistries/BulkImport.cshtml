
@{
    ViewData["Title"] = "Bulk Import Alumni Registry";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:900px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-upload text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Bulk Import Alumni Registry</h3>
                    <small class="text-info">Upload CSV or Excel files for multiple alumni records</small>
                </div>
            </div>

            <hr class="mb-4" />


            <form asp-action="BulkImport" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label for="file" class="form-label fw-semibold"><span class="text-danger">*</span> Select File</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-file-earmark-arrow-up-fill"></i></span>
                        <input type="file" class="form-control rounded-end-3" id="file" name="file" accept=".csv,.xlsx,.xls" required />
                    </div>
                    <div class="form-text">Supported formats: CSV (.csv), Excel (.xlsx, .xls)</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-upload me-2"></i>Upload and Import
                    </button>
                </div>
            </form>

            <div class="card mt-5 border-0 shadow-sm">
                <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary">
                    File Format Instructions
                </div>
                <div class="card-body">
                    <p>The CSV or Excel file should have the following columns in order:</p>
                    <ol>
                        <li><strong>JAG ID</strong> (Required) - Must start with "J00" followed by numbers (e.g., J0012345)</li>
                        <li><strong>First Name</strong> (Required)</li>
                        <li><strong>Last Name</strong> (Required)</li>
                        <li><strong>Graduation Year</strong> (Optional)</li>
                        <li><strong>Degree Program</strong> (Optional)</li>
                        <li><strong>Email On Record</strong> (Optional)</li>
                    </ol>

                    <h6 class="mt-3">CSV Example:</h6>
                    <pre class="bg-light p-3 rounded">JAG ID,First Name,Last Name,Graduation Year,Degree Program,Email On Record
J0012345,John,Doe,2020,Computer Science,john.doe@example.com
J0012346,Jane,Smith,2021,Business Administration,jane.smith@example.com</pre>

                    <h6 class="mt-3">Excel Example:</h6>
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-bordered table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>JAG ID</th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Graduation Year</th>
                                    <th>Degree Program</th>
                                    <th>Email On Record</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>J0012345</td>
                                    <td>John</td>
                                    <td>Doe</td>
                                    <td>2020</td>
                                    <td>Computer Science</td>
                                    <td>john.doe@example.com</td>
                                </tr>
                                <tr>
                                    <td>J0012346</td>
                                    <td>Jane</td>
                                    <td>Smith</td>
                                    <td>2021</td>
                                    <td>Business Administration</td>
                                    <td>jane.smith@example.com</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        <strong>Note:</strong> The first row should contain column headers. Duplicate JAG IDs will be skipped.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
