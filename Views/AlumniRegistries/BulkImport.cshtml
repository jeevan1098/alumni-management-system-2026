@{
    ViewData["Title"] = "Bulk Import Alumni Registry";
}

<h1>Bulk Import Alumni Registry</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4>Upload CSV or Excel File</h4>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @Html.Raw(TempData["SuccessMessage"])
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessages"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong>Errors:</strong><br/>
                        @Html.Raw(TempData["ErrorMessages"])
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="BulkImport" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label for="file" class="form-label">Select File (CSV or Excel)</label>
                        <input type="file" class="form-control" id="file" name="file" accept=".csv,.xlsx,.xls" required />
                        <div class="form-text">
                            Supported formats: CSV (.csv), Excel (.xlsx, .xls)
                        </div>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Upload and Import
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5>File Format Instructions</h5>
            </div>
            <div class="card-body">
                <p>Your CSV or Excel file should have the following columns in order:</p>
                <ol>
                    <li><strong>JAG ID</strong> (Required) - Must start with "J00" followed by numbers (e.g., J0012345)</li>
                    <li><strong>First Name</strong> (Required)</li>
                    <li><strong>Last Name</strong> (Required)</li>
                    <li><strong>Graduation Year</strong> (Optional) - Four-digit year</li>
                    <li><strong>Degree Program</strong> (Optional)</li>
                    <li><strong>Email On Record</strong> (Optional)</li>
                </ol>

                <h6 class="mt-3">CSV Example:</h6>
                <pre class="bg-light p-3">JAG ID,First Name,Last Name,Graduation Year,Degree Program,Email On Record
J0012345,John,Doe,2020,Computer Science,john.doe@example.com
J0012346,Jane,Smith,2021,Business Administration,jane.smith@example.com</pre>

                <h6 class="mt-3">Excel Example:</h6>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>JAG ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Graduation Year</th>
                            <th>Degree Program</th>
                            <th>Email On Record</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>J0012345</td>
                            <td>John</td>
                            <td>Doe</td>
                            <td>2020</td>
                            <td>Computer Science</td>
                            <td>john.doe@example.com</td>
                        </tr>
                        <tr>
                            <td>J0012346</td>
                            <td>Jane</td>
                            <td>Smith</td>
                            <td>2021</td>
                            <td>Business Administration</td>
                            <td>jane.smith@example.com</td>
                        </tr>
                    </tbody>
                </table>

                <div class="alert alert-info mt-3">
                    <strong>Note:</strong> The first row should contain column headers. Duplicate JAG IDs will be skipped.
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

