@{
    ViewData["Title"] = "Bulk Import Alumni Registry";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:900px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-upload text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Bulk Import Alumni</h3>
                    <small class="text-info">Upload CSV or Excel files to create Alumni records (and their Registry entry) in bulk</small>
                </div>
            </div>

            <hr class="mb-4" />

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Html.Raw(TempData["SuccessMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessages"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <strong>Errors:</strong><br />
                    @Html.Raw(TempData["ErrorMessages"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="BulkImport" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label for="file" class="form-label fw-semibold"><span class="text-danger">*</span> Select File</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-file-earmark-arrow-up-fill"></i></span>
                        <input type="file" class="form-control rounded-end-3" id="file" name="file" accept=".csv,.xlsx,.xls" required />
                    </div>
                    <div class="form-text">Supported formats: CSV (.csv), Excel (.xlsx, .xls)</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Alumni" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-upload me-2"></i>Upload and Import
                    </button>
                </div>
            </form>

            <div class="card mt-5 border-0 shadow-sm">
                <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>Sample Import File</span>
                    <span class="d-flex gap-2">
                        <a asp-action="DownloadTemplate" asp-route-format="xlsx" class="btn btn-sm btn-success rounded-pill px-3">
                            <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
                        </a>
                        <a asp-action="DownloadTemplate" asp-route-format="csv" class="btn btn-sm btn-outline-success rounded-pill px-3">
                            <i class="bi bi-filetype-csv me-1"></i>Download CSV
                        </a>
                    </span>
                </div>
                <div class="card-body">
                    <p class="mb-2">Your file should look like this: the first row holds the column names and each row after that is one alumnus. Columns are matched by name, so they can be in any order; any extra columns are ignored.</p>

                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-bordered table-sm mb-0 text-nowrap">
                            <thead class="table-light">
                                <tr>
                                    @foreach (var col in Alumni_Management_System.Controllers.AlumniRegistriesController.TemplateColumns)
                                    {
                                        <th>@col.Header<span class="text-danger">@(col.Required ? "*" : "")</span></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    @foreach (var col in Alumni_Management_System.Controllers.AlumniRegistriesController.TemplateColumns)
                                    {
                                        <td>@col.Sample</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text mb-3"><span class="text-danger">*</span> Required. Scroll the table sideways to see every column.</div>

                    <h6 class="fw-semibold">What each column means</h6>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var col in Alumni_Management_System.Controllers.AlumniRegistriesController.TemplateColumns)
                                {
                                    <tr>
                                        <td class="fw-semibold text-nowrap">@col.Header</td>
                                        <td>@(col.Required ? "Required" : "Optional")</td>
                                        <td>@col.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        <strong>Existing alumni:</strong> if a JAG ID is already in the system, that same record is updated with the values from your file - it is not deleted or recreated, so their login account stays the same. Blank cells leave the existing value unchanged. After the import you'll see which records were updated and what changed.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
