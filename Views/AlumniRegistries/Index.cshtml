@model IEnumerable<Alumni_Management_System.Models.AlumniRegistry>

@{
    ViewData["Title"] = "Alumni Registry";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Alumni Registry</h3>
                    <small class="text-info">List of all registered alumni</small>
                </div>
            </div>

            <hr class="mb-4" />


            <!-- Buttons — Admin only -->
            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex justify-content-end mb-3 gap-2">
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-circle-fill me-2"></i>Create New
                    </a>
                    <a asp-action="BulkImport" class="btn btn-success rounded-pill px-4 shadow-sm">
                        <i class="bi bi-upload me-2"></i>Bulk Import
                    </a>
                </div>
            }

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th><i class="bi bi-credit-card-2-front-fill me-1 text-primary"></i>Jag ID</th>
                            <th><i class="bi bi-person-fill me-1 text-primary"></i>First Name</th>
                            <th><i class="bi bi-person-fill me-1 text-primary"></i>Last Name</th>
                            <th><i class="bi bi-check-circle-fill me-1 text-primary"></i>Account Created</th>
                            <th><i class="bi bi-list-task me-1 text-primary"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(a => a.LastName))
                        {
                            <tr class="text-center">
                                <td class="fw-semibold">@item.JagId</td>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>
                                    @if (item.AccountCreated)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-info">
                                            <i class="bi bi-x-circle me-1"></i>No
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.RegistryId"
                                       class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.RegistryId"
                                           class="btn btn-sm btn-outline-warning rounded-pill">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.RegistryId"
                                           class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" asp-controller="Home"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house-fill me-2"></i>Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
