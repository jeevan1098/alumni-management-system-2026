@model IEnumerable<Alumni_Management_System.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalRecords = (int)(ViewData["TotalRecords"] ?? 0);
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1><i class="bi bi-shield-check"></i> Audit Logs</h1>
            <p class="text-muted">System activity tracking and monitoring</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filters</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="searchUser" class="form-label">User</label>
                        <input type="text" class="form-control" id="searchUser" name="searchUser" 
                               value="@ViewData["SearchUser"]" placeholder="Username or ID">
                    </div>
                    <div class="col-md-2">
                        <label for="searchAction" class="form-label">Action</label>
                        <select class="form-select" id="searchAction" name="searchAction">
                            <option value="">All Actions</option>
                            <option value="Create" selected="@(ViewData["SearchAction"]?.ToString() == "Create")">Create</option>
                            <option value="Update" selected="@(ViewData["SearchAction"]?.ToString() == "Update")">Update</option>
                            <option value="Delete" selected="@(ViewData["SearchAction"]?.ToString() == "Delete")">Delete</option>
                            <option value="Read" selected="@(ViewData["SearchAction"]?.ToString() == "Read")">Read</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="searchEntity" class="form-label">Entity</label>
                        <input type="text" class="form-control" id="searchEntity" name="searchEntity" 
                               value="@ViewData["SearchEntity"]" placeholder="Entity name">
                    </div>
                    <div class="col-md-2">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" 
                               value="@ViewData["StartDate"]">
                    </div>
                    <div class="col-md-2">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" 
                               value="@ViewData["EndDate"]">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-12">
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary -->
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> 
        Showing <strong>@Model.Count()</strong> of <strong>@totalRecords</strong> total audit log entries
    </div>

    <!-- Audit Logs Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>IP Address</th>
                            <th>Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <small>@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                </td>
                                <td>
                                    <strong>@item.UserName</strong><br />
                                    <small class="text-muted">@item.UserId</small>
                                </td>
                                <td>
                                    @if (item.Action == "Create")
                                    {
                                        <span class="badge bg-success">@item.Action</span>
                                    }
                                    else if (item.Action == "Update")
                                    {
                                        <span class="badge bg-warning text-dark">@item.Action</span>
                                    }
                                    else if (item.Action == "Delete")
                                    {
                                        <span class="badge bg-danger">@item.Action</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@item.Action</span>
                                    }
                                </td>
                                <td>@item.EntityName</td>
                                <td><code>@item.EntityId</code></td>
                                <td><small>@item.IpAddress</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Details))
                                    {
                                        <small>@(item.Details.Length > 50 ? item.Details.Substring(0, 50) + "..." : item.Details)</small>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.AuditId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Audit log pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" 
                       asp-route-searchUser="@ViewData["SearchUser"]"
                       asp-route-searchAction="@ViewData["SearchAction"]"
                       asp-route-searchEntity="@ViewData["SearchEntity"]"
                       asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-searchUser="@ViewData["SearchUser"]"
                           asp-route-searchAction="@ViewData["SearchAction"]"
                           asp-route-searchEntity="@ViewData["SearchEntity"]"
                           asp-route-startDate="@ViewData["StartDate"]"
                           asp-route-endDate="@ViewData["EndDate"]">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                       asp-route-searchUser="@ViewData["SearchUser"]"
                       asp-route-searchAction="@ViewData["SearchAction"]"
                       asp-route-searchEntity="@ViewData["SearchEntity"]"
                       asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

