@model Alumni_Management_System.Models.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1><i class="bi bi-file-text"></i> Audit Log Details</h1>
            <p class="text-muted">Detailed information about this audit log entry</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Audit Log #@Model.AuditId</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Timestamp</dt>
                <dd class="col-sm-9">
                    <i class="bi bi-clock"></i> @Model.Timestamp.ToString("dddd, MMMM dd, yyyy 'at' hh:mm:ss tt")
                </dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9">
                    <strong>@Model.UserName</strong><br />
                    <small class="text-muted">User ID: @Model.UserId</small>
                </dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">
                    @if (Model.Action == "Create")
                    {
                        <span class="badge bg-success fs-6">@Model.Action</span>
                    }
                    else if (Model.Action == "Update")
                    {
                        <span class="badge bg-warning text-dark fs-6">@Model.Action</span>
                    }
                    else if (Model.Action == "Delete")
                    {
                        <span class="badge bg-danger fs-6">@Model.Action</span>
                    }
                    else
                    {
                        <span class="badge bg-info fs-6">@Model.Action</span>
                    }
                </dd>

                <dt class="col-sm-3">Entity Type</dt>
                <dd class="col-sm-9">
                    <code>@Model.EntityName</code>
                </dd>

                <dt class="col-sm-3">Entity ID</dt>
                <dd class="col-sm-9">
                    <code>@Model.EntityId</code>
                </dd>

                <dt class="col-sm-3">IP Address</dt>
                <dd class="col-sm-9">
                    <i class="bi bi-geo-alt"></i> @Model.IpAddress
                </dd>

                <dt class="col-sm-3">Details</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Details))
                    {
                        <div class="alert alert-light">
                            <pre class="mb-0">@Model.Details</pre>
                        </div>
                    }
                    else
                    {
                        <em class="text-muted">No additional details</em>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

