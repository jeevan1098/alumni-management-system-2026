
@model Alumni_Management_System.Models.AlumniInternship

@{
    ViewData["Title"] = "Internship Details";
    var alumniName = Model.Alumni != null
        ? $"{(!string.IsNullOrEmpty(Model.Alumni.PreferredFirstName) ? Model.Alumni.PreferredFirstName : Model.Alumni.FirstName)} {Model.Alumni.LastName}"
        : "Unknown Alumni";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-journal-text text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Internship Details of <span class="text-primary">@alumniName</span>
                    </h3>
                    <small class="text-info">View internship information for this alumni</small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="row g-4">
                <!-- Internship Info -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-briefcase-fill me-2"></i>Internship & Employer
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">Internship Type</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.InternshipType))
                            {
                                <span class="badge bg-info text-dark">@Model.InternshipType</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Title</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.Title))
                            {
                                @Model.Title
                            }
                            else
                            {
                                <span class="text-danger">Not Answered</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Employer</dt>
                        <dd class="col-sm-7">
                            @if (Model.Employer != null)
                            {
                                @Model.Employer.EmployerName
                            }
                            else
                            {
                                <span class="text-danger">Not Assigned</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Dates & Alumni Info -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-calendar-event me-2"></i>Dates & Alumni
                    </h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">Start Date</dt>
                        <dd class="col-sm-7">
                            @Model.StartDate.ToString("MMMM dd, yyyy")
                        </dd>

                        <dt class="col-sm-5">End Date</dt>
                        <dd class="col-sm-7">
                            @Model.EndDate.ToString("MMMM dd, yyyy")
                        </dd>

                        <dt class="col-sm-5">Alumni</dt>
                        <dd class="col-sm-7">
                            @alumniName
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model?.AlumniInternshipId" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil-square me-2"></i>Edit
                    </a>
                }
            </div>

        </div>
    </div>
</div>