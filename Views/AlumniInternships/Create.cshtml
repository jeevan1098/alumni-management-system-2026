@model Alumni_Management_System.Models.AlumniInternship

@{
    ViewData["Title"] = "Create Internship";
    var userRole = ViewData["UserRole"]?.ToString();
    bool isAdmin = userRole == "Admin";
    bool isAlumni = userRole == "Alumni";
    int? currentAlumniId = ViewData["CurrentAlumniId"] as int?;
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
            <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
        </div>
        <div>
            <h2 class="fw-bold mb-0">Add Internship</h2>
            <small class="text-info">Create a new internship record</small>
        </div>
    </div>

    <!-- Card -->
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 700px;">
        <div class="card-body p-4">

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Alumni Name -->
                <div class="mb-3">
                    <label asp-for="AlumniId" class="form-label fw-semibold">Alumni Name</label>
                    @if (isAdmin)
                    {
                        <select asp-for="AlumniId" class="form-select rounded-3" asp-items="ViewBag.AlumniId">
                            <option value="">-- Select an Alumni --</option>
                        </select>
                    }
                    else
                    {
                        <select asp-for="AlumniId" class="form-select rounded-3" asp-items="ViewBag.AlumniId" disabled>
                        </select>
                        <input type="hidden" asp-for="AlumniId" value="@currentAlumniId" />
                    }
                </div>

                <!-- Employer -->
                <div class="mb-3">
                    <label asp-for="EmployerId" class="form-label fw-semibold">Employer Name</label>
                    <select asp-for="EmployerId"
                            class="form-select rounded-3"
                            asp-items="ViewBag.EmployerId"
                            id="employerDropdown">

                    </select>
                </div>

                <!-- Other Employer -->
                <div class="mb-3" id="otherEmployerDiv" style="display:none;">
                    <label class="form-label fw-semibold">Enter Employer Name</label>
                    <input type="text"
                           name="OtherEmployerName"
                           class="form-control rounded-3"
                           placeholder="Enter employer name" />
                </div>

                <div class="row g-3">
                    <!-- Internship Type -->
                    <div class="col-md-6">
                        <label asp-for="InternshipType" class="form-label fw-semibold"></label>
                        <input asp-for="InternshipType" class="form-control rounded-3" placeholder="e.g., Summer Internship" />
                        <span asp-validation-for="InternshipType" class="text-danger"></span>
                    </div>

                    <!-- Title -->
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="Enter job title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <!-- Start Date -->
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" class="form-control rounded-3" id="endDateField" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Current Internship Checkbox -->
                <div class="form-check mt-3 mb-4">
                    <input type="checkbox" class="form-check-input" id="isCurrentInternshipCheckbox">
                    <label class="form-check-label fw-semibold" for="isCurrentInternshipCheckbox">
                        Current Internship
                    </label>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i>Create
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const employerDropdown = document.getElementById("employerDropdown");
        const otherDiv = document.getElementById("otherEmployerDiv");
        const currentInternshipCheckbox = document.getElementById("isCurrentInternshipCheckbox");
        const endDateField = document.getElementById("endDateField");

        employerDropdown.addEventListener("change", function () {
            otherDiv.style.display = this.value == "0" ? "block" : "none";
        });

        currentInternshipCheckbox.addEventListener("change", function () {
            endDateField.disabled = this.checked;
            if (this.checked) endDateField.value = "";
        });
    </script>
}
