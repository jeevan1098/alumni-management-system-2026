@model Alumni_Management_System.Models.UserAccessScope

@{
    ViewData["Title"] = "Edit Access Scope";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-pencil-square text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Edit Access Scope</h3>
                    <small class="text-info text-warning">Leave College blank for system-wide access</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Edit" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="UserAccessScopeId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="UserId" class="form-label fw-semibold"></label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RoleId" class="form-label fw-semibold"></label>
                        <select asp-for="RoleId" class="form-select" asp-items="ViewBag.RoleId"></select>
                        <span asp-validation-for="RoleId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CollegeId" class="form-label fw-semibold">College (blank = system-wide)</label>
                        <select asp-for="CollegeId" class="form-select" asp-items="ViewBag.CollegeId">
                            <option value="">-- System-wide --</option>
                        </select>
                        <span asp-validation-for="CollegeId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Department (optional)</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId">
                            <option value="">-- All Departments --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AccessLevel" class="form-label fw-semibold"></label>
                    <select asp-for="AccessLevel" class="form-select">
                        <option value="Full">Full</option>
                        <option value="ReadOnly">Read Only</option>
                    </select>
                    <span asp-validation-for="AccessLevel" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
