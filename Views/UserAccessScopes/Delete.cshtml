@model Alumni_Management_System.Models.UserAccessScope

@{
    ViewData["Title"] = "Revoke Access Scope";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <div class="text-center mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                <h2 class="fw-bold text-danger mt-3">
                    Revoke Access for <span class="text-primary">@Model.User?.UserName</span>
                </h2>
                <p class="text-info">This will remove this role/scope grant.</p>
            </div>

            <hr class="mb-4" />

            <dl class="row mb-4">
                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@Model.Role?.Name</dd>

                <dt class="col-sm-3">Scope</dt>
                <dd class="col-sm-9">
                    @if (Model.College == null)
                    {
                        <span class="badge bg-info text-dark">System-wide</span>
                    }
                    else
                    {
                        @Model.College.CollegeName
                        @if (Model.Department != null)
                        {
                            <text> / @Model.Department.DepartmentName</text>
                        }
                    }
                </dd>

                <dt class="col-sm-3">Access Level</dt>
                <dd class="col-sm-9">@Model.AccessLevel</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="UserAccessScopeId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash-fill me-2"></i>Confirm Revoke
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
