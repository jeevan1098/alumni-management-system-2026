@model Alumni_Management_System.Models.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:600px;">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-person-plus-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Create User</h3>
                    <small class="text-info">Create an Admin or Staff account</small>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill me-2"></i>A temporary username will be generated for this account, and the temporary username + password below will be emailed to the address you enter. The new user will choose their own permanent username and password the first time they log in.
            </div>

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>If the JAG ID below already belongs to an existing account (e.g. an Alumni who is also becoming Staff), Email and Temporary Password are ignored - the selected Role is simply added to that existing account instead of creating a new one.
            </div>

            <form asp-action="Create" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="JagId" class="form-label fw-semibold"></label>
                    <input asp-for="JagId" class="form-control" placeholder="J0000003" />
                    <span asp-validation-for="JagId" class="text-danger"></span>
                    <small class="text-muted">Must start with 'J00' followed by numbers. A suggested value is pre-filled.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@university.edu" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <small class="text-muted">Only used if this JAG ID doesn't already have an account.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small class="text-muted">At least 8 characters, with upper/lowercase, a digit, and a symbol. This is temporary - the user sets their own on first login. Only used if this JAG ID doesn't already have an account.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Staff">Staff</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                    <small class="text-muted">Two-factor authentication is mandatory and will be enabled automatically.</small>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
