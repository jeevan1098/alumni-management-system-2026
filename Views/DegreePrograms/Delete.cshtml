@model Alumni_Management_System.Models.DegreeProgram

@{
    ViewData["Title"] = "Delete Degree Program";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-trash-fill text-danger fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Delete Degree Program: <span class="text-primary">@Model.DegreeType</span>
                    </h3>
                    <small class="text-info">Are you sure you want to permanently delete this degree program?</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Degree Details -->
            <dl class="row mb-4">
                <dt class="col-md-3 fw-semibold">
                    <i class="bi bi-building me-2 text-danger"></i>Institution
                </dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Institution)</dd>

                <dt class="col-md-3 fw-semibold">
                    <i class="bi bi-mortarboard-fill me-2 text-danger"></i>Degree Type
                </dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.DegreeType)</dd>

                <dt class="col-md-3 fw-semibold">
                    <i class="bi bi-journal-text me-2 text-danger"></i>Major Field of Study
                </dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.MajorFieldOfStudy)</dd>

                <dt class="col-md-3 fw-semibold">
                    <i class="bi bi-building-fill-check me-2 text-danger"></i>Department
                </dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Department)</dd>
            </dl>

            <!-- Delete Confirmation Buttons -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="DegreeId" />
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>