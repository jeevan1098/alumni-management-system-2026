@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Privacy Policy";
}


<div class="banner mb-4">
    <h3>Privacy Policy</h3>
    <p class="mb-0">Alumni Management System — Data Protection & Privacy</p>
</div>

<div class="card-soft p-4">

    <h5>1. Introduction</h5>
    <p>
        The Alumni Management System is committed to protecting the privacy and personal
        information of all alumni, students, and administrators who use this platform.
        This policy explains how we collect, use, and safeguard your information.
    </p>

    <h5 class="mt-4">2. Information We Collect</h5>
    <ul>
        <li>Personal details (Name, Email, Phone, Address)</li>
        <li>Academic information (Degree, Graduation Year, Program)</li>
        <li>Professional information (Employment, Organization)</li>
        <li>System activity (Login, Messages, Updates)</li>
    </ul>

    <h5 class="mt-4">3. How We Use Your Information</h5>
    <ul>
        <li>To manage alumni records and communication</li>
        <li>To provide networking and professional opportunities</li>
        <li>To improve system functionality and reporting</li>
        <li>To ensure system security and authentication</li>
    </ul>

    <h5 class="mt-4">4. Data Protection</h5>
    <p>
        We implement industry-standard security measures including authentication,
        encrypted communication, and controlled access to ensure your data is protected.
        Only authorized administrators can access sensitive information.
    </p>

    <h5 class="mt-4">5. Data Sharing</h5>
    <p>
        Your personal data is never sold or shared with third parties. Information is
        only used within the Alumni Management System for official University purposes.
    </p>

    <h5 class="mt-4">6. Your Rights</h5>
    <ul>
        <li>You may update your profile at any time</li>
        <li>You may request data correction</li>
        <li>You may request account deactivation</li>
    </ul>

    <h5 class="mt-4">7. Contact</h5>
    <p>
        For privacy-related concerns, please reach out to one of the contacts below or the
        University IT department.
    </p>
    <ul class="list-unstyled ms-1">
        <li class="mb-2">
            <i class="bi bi-envelope me-2"></i><strong>System administrator:</strong>
            <a href="mailto:@Configuration["AdminContactEmail"]">@Configuration["AdminContactEmail"]</a>
        </li>
        <li class="mb-2">
            <i class="bi bi-envelope me-2"></i><strong>School of Computing (SOC) administrator:</strong>
            <a href="mailto:@Configuration["SocAdminContactEmail"]">@Configuration["SocAdminContactEmail"]</a>
        </li>
        <li class="mb-2">
            <i class="bi bi-geo-alt me-2"></i><strong>Mailing address:</strong>
            University of South Alabama, 307 N University Blvd, Mobile, AL 36688
        </li>
    </ul>

    <hr />

    <p class="text-info small mb-0">
        © @DateTime.Now.Year Alumni Management System — All Rights Reserved
    </p>

</div>
