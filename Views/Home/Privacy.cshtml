@using Alumni_Management_System.Services
@inject SiteContentRenderer SiteContent

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Privacy Policy";
}


<div class="banner mb-4 d-flex justify-content-between align-items-start">
    <div>
        <h3>Privacy Policy</h3>
        <p class="mb-0">Alumni Management System — Data Protection & Privacy</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="SiteContent" asp-action="Edit" asp-route-id="@SiteContentDefinitions.PrivacyPage"
           asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-light rounded-pill">
            <i class="bi bi-pencil-square me-1"></i>Edit this page
        </a>
    }
</div>

<partial name="_StatusMessages" />

<div class="card-soft p-4 site-content">

    @SiteContent.RenderPage(SiteContentDefinitions.PrivacyPage)

    <hr />

    <p class="text-info small mb-0">
        © @DateTime.Now.Year Alumni Management System — All Rights Reserved
    </p>

</div>
