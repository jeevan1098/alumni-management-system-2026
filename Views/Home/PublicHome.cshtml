@{
    Layout = null;   // ❗ NO SIDEBAR BEFORE LOGIN
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alumni Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body {
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .home-container { max-width: 1000px; width: 100%; margin: 20px; }
        .home-card { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden; }

        .home-left {
            background: linear-gradient(135deg, #003366 0%, #0052a3 100%);
            color: white;
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .home-right { padding: 60px 50px; display: flex; flex-direction: column; justify-content: center; }

        .welcome-text { font-size: 32px; font-weight: 700; margin-bottom: 20px; }
        .welcome-desc { font-size: 16px; opacity: 0.9; line-height: 1.6; }

        .feature-item { display: flex; align-items: center; margin: 15px 0; font-size: 14px; }
        .feature-item i { font-size: 24px; margin-right: 15px; color: #ffd700; }

        .home-title { font-size: 26px; font-weight: 700; margin-bottom: 8px; color: #003366; }
        .home-subtitle { color: #666; margin-bottom: 32px; }

        .action-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 22px;
            border-radius: 14px;
            text-decoration: none;
            margin-bottom: 14px;
            transition: transform 0.2s, box-shadow 0.2s;
            border: 2px solid transparent;
        }

        .action-card:hover { transform: translateY(-2px); }

        .action-card .action-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .action-card .action-title { font-weight: 700; margin-bottom: 2px; }
        .action-card .action-desc { font-size: 13px; opacity: 0.85; }

        .action-primary {
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(0,51,102,0.25);
        }
        .action-primary .action-icon { background: rgba(255,255,255,0.15); color: white; }
        .action-primary:hover { color: white; box-shadow: 0 8px 20px rgba(0,51,102,0.35); }

        .action-secondary {
            background: #f4f7fb;
            color: #003366;
            border-color: #e0e7f1;
        }
        .action-secondary .action-icon { background: #dbe6f5; color: #003366; }
        .action-secondary:hover { color: #003366; border-color: #0066cc; }

        .action-tertiary {
            background: #fff9e6;
            color: #7a5c00;
            border-color: #ffe9a8;
        }
        .action-tertiary .action-icon { background: #ffe9a8; color: #7a5c00; }
        .action-tertiary:hover { color: #7a5c00; border-color: #e0b400; }
    </style>
</head>
<body>
    <div class="home-container">
        <div class="home-card">
            <div class="row g-0">
                <div class="col-md-5 home-left">
                    <div>
                        <i class="bi bi-mortarboard-fill" style="font-size: 80px; margin-bottom: 20px;"></i>
                        <h1 class="welcome-text">Welcome!</h1>
                        <p class="welcome-desc">University of South Alabama<br />Alumni Management System</p>
                        <hr style="border-color: rgba(255,255,255,0.3); width: 80%; margin: 30px auto;" />
                        <div class="text-start" style="max-width: 300px;">
                            <div class="feature-item"><i class="bi bi-people-fill"></i><span>Connect with fellow alumni</span></div>
                            <div class="feature-item"><i class="bi bi-briefcase-fill"></i><span>Track your career journey</span></div>
                            <div class="feature-item"><i class="bi bi-calendar-event-fill"></i><span>Stay updated with events</span></div>
                            <div class="feature-item"><i class="bi bi-chat-dots-fill"></i><span>Receive important messages</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7 home-right">
                    <h2 class="home-title"><i class="bi bi-house-door-fill me-2"></i>Get Started</h2>
                    <p class="home-subtitle">Choose how you'd like to continue</p>

                    <a asp-area="Identity" asp-page="/Account/Login" class="action-card action-primary">
                        <div class="action-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                        <div>
                            <div class="action-title">Sign In</div>
                            <div class="action-desc">Already have an account? Log in here.</div>
                        </div>
                    </a>

                    <a asp-controller="Account" asp-action="VerifyJagId" class="action-card action-secondary">
                        <div class="action-icon"><i class="bi bi-person-plus-fill"></i></div>
                        <div>
                            <div class="action-title">Register as New Alumni</div>
                            <div class="action-desc">First time here? Verify your JAG ID to create your account.</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        <div class="text-center mt-4"><p class="text-white"><small>&copy; @DateTime.Now.Year University of South Alabama. All rights reserved.</small></p></div>
    </div>
</body>
</html>
