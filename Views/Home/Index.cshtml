@{
    ViewData["Title"] = "Dashboard";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- HEADER -->
<div class="banner">
    <h3>Welcome to Alumni Management System</h3>
    <p class="mb-0">Manage alumni, programs, employment and system activity</p>
</div>

<!-- STATS -->
<div class="row g-3 mb-4">

    <div class="col-md-2">
        <div class="card-soft stat1 text-center">
            <div class="stat-number">@ViewData["TotalAlumni"]</div>
            Alumni
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-soft stat2 text-center">
            <div class="stat-number">@ViewData["TotalRegistry"]</div>
            Registry
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-soft stat3 text-center">
            <div class="stat-number">@ViewData["TotalUsers"]</div>
            Users
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-soft stat4 text-center">
            <div class="stat-number">@ViewData["TotalMessages"]</div>
            Messages
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-soft stat5 text-center">
            <div class="stat-number">@ViewData["TotalEmployments"]</div>
            Employments
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-soft stat6 text-center">
            <div class="stat-number">@ViewData["PendingApprovals"]</div>
            Pending
        </div>
    </div>

</div>

<!-- CHART + ACTIVITY -->
<div class="row g-3 mb-4">

    <!-- Chart -->
    <div class="col-lg-8">
        <div class="card-soft p-3">
            <h6>Alumni Growth</h6>
            <canvas id="chart" height="110"></canvas>
        </div>
    </div>

    <!-- Activity -->
    <div class="col-lg-4">
        <div class="card-soft p-3">
            <h6>Recent Activity</h6>
            <ul class="small mb-0">

                @if (ViewBag.RecentActivity != null)
                {
                    foreach (var item in ViewBag.RecentActivity)
                    {
                        <li>@item</li>
                    }
                }
                else
                {
                    <li>No recent activity</li>
                }

            </ul>
        </div>
    </div>

</div>

<!-- MODULE BOXES -->
<div class="row g-3">

    <div class="col-md-3">
        <a asp-controller="DegreePrograms" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-mortarboard fs-3"></i>
                <div>Degree Programs</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="AlumniDegrees" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-award fs-3"></i>
                <div>Alumni Degrees</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="AlumniInternships" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-person-workspace fs-3"></i>
                <div>Internships</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="AlumniOrganizations" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-diagram-3 fs-3"></i>
                <div>Organizations</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Employers" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-building fs-3"></i>
                <div>Employers</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Messages" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-envelope fs-3"></i>
                <div>Messages</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="AlumniRegistries" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-journal-text fs-3"></i>
                <div>Registry</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Alumni" asp-action="Index" class="text-decoration-none">
            <div class="card-soft text-center">
                <i class="bi bi-people fs-3"></i>
                <div>Alumni</div>
            </div>
        </a>
    </div>

</div>

<!-- CHART SCRIPT -->
<script>
    var labels = [];
    var data = [];

    @if (ViewBag.ChartLabels != null && ViewBag.ChartData != null)
    {
        <text>
            labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
            data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));
        </text>
    }

    var ctx = document.getElementById('chart');

    if (ctx && labels.length > 0) {
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            precision: 0
                        }
                    }
                }
            }
        });
    }
</script>
