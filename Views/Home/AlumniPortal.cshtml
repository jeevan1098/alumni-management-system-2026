@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewData["MissingProfile"] as bool? == true)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-person-exclamation fs-4"></i>
            <div>
                <strong>Your alumni profile hasn't been set up yet.</strong><br />
                Your login isn't linked to an alumni record, so My Profile, employment, internships and other profile pages won't work.
                Please contact the alumni office and give them your JAG ID so they can create your profile.
            </div>
        </div>
    }


    <!-- ================= HERO ================= -->
    <div class="hero mb-4">

        <div>
            <h2>Welcome back, @User.Identity.Name 👋</h2>

            <p>
                Manage your alumni profile, track career progress,
                and stay connected with the
                <strong>University of South Alabama</strong>.
            </p>
        </div>

    </div>



    <!-- ================= PROFILE STATUS ================= -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between">
                <h5>Profile Completion</h5>
                <strong>@ViewData["ProfileCompletion"]%</strong>
            </div>

            <div class="progress mt-2" style="height:10px;">
                <div class="progress-bar bg-success"
                     style="width:@ViewData["ProfileCompletion"]%">
                </div>
            </div>

        </div>
    </div>



    <!-- ================= QUICK ACTIONS ================= -->
    <h5 class="mb-3">Quick Actions</h5>

    <div class="row g-4">

        <div class="col-md-4">
            <a asp-controller="Alumni" asp-action="MyProfile"
               class="quick-card">
                <i class="bi bi-person"></i>
                <span>My Profile</span>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AlumniDegrees" asp-action="Index"
               class="quick-card">
                <i class="bi bi-award"></i>
                <span>Degrees</span>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AlumniMessages" asp-action="Index"
               class="quick-card">
                <i class="bi bi-chat-dots"></i>
                <span>Messages</span>
            </a>
        </div>

    </div>



    <!-- ================= ALUMNI INFO ================= -->
    <div class="card shadow-sm border-0 mt-5">
        <div class="card-body">

            <h5>South Alabama Alumni Network</h5>

            <p>
                The University of South Alabama Alumni Association
                connects graduates worldwide through mentorship,
                innovation programs, and professional networking.
            </p>

        </div>
    </div>

</div>