

@model Alumni_Management_System.Models.Alumni

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- ================= HERO ================= -->
    <div class="hero mb-4">

        <div>
            <h2>Welcome back, @User.Identity.Name 👋</h2>

            <p>
                Manage your alumni profile, track career progress,
                and stay connected with the
                <strong>University of South Alabama</strong>.
            </p>
        </div>

    </div>

    <div class="card mb-4 p-3">
        <h5>Alumni Profile</h5>
        @if (Model == null)
        {
            <p class="text-warning">Your alumni profile is not yet linked. Please contact admin.</p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-3">JAG ID</dt>
                <dd class="col-sm-9">@Model.JagId</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.PermanentEmail</dd>

                <dt class="col-sm-3">Graduation Year</dt>
                <dd class="col-sm-9">@Model.GraduationYear</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Address, @Model.City, @Model.State, @Model.Postcode</dd>
            </dl>
        }
    </div>

    <!-- ================= PROFILE STATUS ================= -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between">
                <h5>Profile Completion</h5>
                <strong>@ViewData["ProfileCompletion"]%</strong>
            </div>

            <div class="progress mt-2" style="height:10px;">
                <div class="progress-bar bg-success"
                     style="width:@ViewData["ProfileCompletion"]%">
                </div>
            </div>

        </div>
    </div>

    <!-- ================= QUICK ACTIONS ================= -->
    <h5 class="mb-3">Quick Actions</h5>

    <div class="row g-4">

        <div class="col-md-4">
            <a asp-controller="Alumni" asp-action="MyProfile"
               class="quick-card">
                <i class="bi bi-person"></i>
                <span>My Profile</span>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AlumniDegrees" asp-action="Index"
               class="quick-card">
                <i class="bi bi-award"></i>
                <span>Degrees</span>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Messages" asp-action="Index"
               class="quick-card">
                <i class="bi bi-chat-dots"></i>
                <span>Messages</span>
            </a>
        </div>

    </div>

    <!-- ================= ALUMNI INFO ================= -->
    <div class="card shadow-sm border-0 mt-5">
        <div class="card-body">

            <h5>South Alabama Alumni Network</h5>

            <p>
                The University of South Alabama Alumni Association
                connects graduates worldwide through mentorship,
                innovation programs, and professional networking.
            </p>

        </div>
    </div>

</div>