@model Alumni_Management_System.Models.OrganizationType

@{
    ViewData["Title"] = "Organization Type Details";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-building text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">
                        Organization Type Details
                    </h3>
                    <small class="text-info">View information about this organization type</small>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Organization Info -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-info-circle me-2"></i>Organization Information
            </h5>
            <dl class="row mb-4">
                <dt class="col-sm-5">Organization Name</dt>
                <dd class="col-sm-7">
                    @if (!string.IsNullOrEmpty(Model.OrganizationName))
                    {
                        @Model.OrganizationName
                    }
                    else
                    {
                        <span class="badge bg-danger">Not Answered</span>
                    }
                </dd>
            </dl>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.OrganizationTypeId" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
            </div>

        </div>
    </div>
</div>