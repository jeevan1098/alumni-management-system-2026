@model Alumni_Management_System.Models.OrganizationType

@{
    ViewData["Title"] = "Add Organization Type";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:600px;">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-building text-primary fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Add Organization Type</h3>
                    <small class="text-muted">Enter organization type information</small>
                </div>
            </div>

            <hr class="mb-4" />

            <form asp-action="Create" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Organization Name -->
                <div class="mb-3">
                    <label asp-for="OrganizationName" class="form-label fw-semibold">
                        <span class="text-danger">*</span> Organization Name
                    </label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-building"></i>
                        </span>
                        <input asp-for="OrganizationName" class="form-control rounded-end-3" placeholder="Enter organization type" />
                    </div>
                    <span asp-validation-for="OrganizationName" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
