@* Branded shell shared by every screen shown before (or while) signing in:
   public home, sign in, 2FA, registration, forgot password and first-login password setup. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Alumni Management System")</title>
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/usa-icon-180.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/usa-brand.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="usa-brand">
    <div class="auth-container">
        <div class="auth-card usa-card">
            <div class="row g-0">
                <div class="col-md-5 usa-panel">
                    <div>
                        <img src="~/images/usa-logo.png" asp-append-version="true" alt="University of South Alabama" class="usa-seal" />
                        <p class="usa-university">University of<br />South Alabama</p>
                        <hr class="usa-rule" />
                        <h1 class="usa-alumni">Alumni</h1>
                        <p class="usa-footer-tag">Mobile, Alabama</p>
                    </div>
                </div>
                <div class="col-md-7 auth-right">
                    @RenderBody()
                </div>
            </div>
        </div>
        <div class="text-center mt-4"><p class="text-white"><small>&copy; @DateTime.Now.Year University of South Alabama. All rights reserved.</small></p></div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
