@model Alumni_Management_System.Models.ViewModels.ChangeTempPasswordViewModel

@{
    ViewData["Title"] = "Set a New Password";
    Layout = "_AuthLayout";
}

<div class="auth-icon"><i class="bi bi-key-fill"></i></div>
<h2 class="auth-title">Set a New Password</h2>
<p class="auth-subtitle">You signed in with a temporary password. Choose your own before continuing.</p>

<form asp-action="ChangeTempPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="TempPassword" class="form-label"></label>
        <input asp-for="TempPassword" type="password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="TempPassword" class="text-danger"></span>
        <div class="form-text">The temporary password that was emailed to you.</div>
    </div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
        <div class="form-text">At least 8 characters, with upper/lowercase, a digit, and a symbol.</div>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="w-100 btn btn-usa">
        <i class="bi bi-check-circle-fill me-2"></i>Save and Continue
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
