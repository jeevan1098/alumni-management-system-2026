@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Change Password | Alumni Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1f3c88, #3f7cac);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 440px;
            width: 100%;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
        }

            .form-control:focus {
                border-color: #1f3c88;
                box-shadow: 0 0 0 0.2rem rgba(31,60,136,0.15);
            }

        .btn-primary {
            background: linear-gradient(135deg, #1f3c88, #3f7cac);
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="card p-5">
        <div class="text-center mb-4">
            <div class="rounded-circle bg-warning d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                <i class="bi bi-shield-lock-fill fs-2 text-dark"></i>
            </div>
            <h4 class="fw-bold">Change Your Password</h4>
            <p class="text-muted small">You must change your password before continuing.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
        }

        <form method="post" asp-action="ChangePassword" asp-controller="Account">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="bi bi-lock-fill me-1"></i>New Password</label>
                <input type="password" name="newPassword" class="form-control" placeholder="Enter new password" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold"><i class="bi bi-lock-fill me-1"></i>Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm new password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check-circle-fill me-2"></i>Change Password
            </button>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
