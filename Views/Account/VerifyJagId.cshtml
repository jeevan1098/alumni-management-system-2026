@model Alumni_Management_System.Models.ViewModels.VerifyJagIdViewModel

@{
    ViewData["Title"] = "Verify JAG ID";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-person-check"></i> Alumni Registration - Step 1</h3>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Verify Your JAG ID</h5>
                    <p class="text-info">
                        Please enter your JAG ID to begin the registration process. Your JAG ID must be registered in our Alumni Registry.
                    </p>

                    <form asp-action="VerifyJagId" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="JagId" class="form-label"></label>
                            <input asp-for="JagId" class="form-control form-control-lg" placeholder="J0012345" autofocus />
                            <span asp-validation-for="JagId" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> JAG ID must start with 'J00' followed by numbers (e.g., J0012345)
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-right-circle"></i> Verify JAG ID
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="mb-2">Already have an account?</p>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                    </div>

                    <div class="alert alert-info mt-3" role="alert">
                        <h6 class="alert-heading"><i class="bi bi-question-circle"></i> Need Help?</h6>
                        <p class="mb-0">
                            If your JAG ID is not found or you're experiencing issues, please contact the administrator for assistance.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

