@model Alumni_Management_System.Models.ViewModels.VerifyJagIdViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Verify JAG ID";
    Layout = "_AuthLayout";
    var adminEmail = Configuration["AdminContactEmail"];
}

<span class="auth-step">Alumni Registration &middot; Step 1 of 2</span>
<h2 class="auth-title"><i class="bi bi-person-check me-2"></i>Verify Your JAG ID</h2>
<p class="auth-subtitle">Enter your JAG ID to begin registration. It must already be in the Alumni Registry.</p>

<form asp-action="VerifyJagId" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-4">
        <label asp-for="JagId" class="form-label"></label>
        <input asp-for="JagId" class="form-control" placeholder="@JagIdFormat.Example" maxlength="@JagIdFormat.Length" autofocus />
        <span asp-validation-for="JagId" class="text-danger"></span>
        <div class="form-text">
            <i class="bi bi-info-circle me-1"></i>@JagIdFormat.Hint
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" placeholder="Doe" />
        <span asp-validation-for="LastName" class="text-danger"></span>
        <div class="form-text">
            <i class="bi bi-info-circle me-1"></i>Must match the last name on file in the Alumni Registry
        </div>
    </div>

    <button type="submit" class="w-100 btn btn-usa">
        <i class="bi bi-arrow-right-circle me-2"></i>Verify JAG ID
    </button>
</form>

<div class="auth-note mt-4">
    <i class="bi bi-question-circle me-1"></i><strong>Need help?</strong>
    @if (!string.IsNullOrWhiteSpace(adminEmail))
    {
        <text>If your JAG ID is not found, please contact the administrator at
        <a href="mailto:@adminEmail" class="link-text">@adminEmail</a> for assistance.</text>
    }
    else
    {
        <text>If your JAG ID is not found, please contact the administrator for assistance.</text>
    }
</div>

<div class="text-center mt-4">
    Already have an account?
    <a asp-area="Identity" asp-page="/Account/Login" class="link-text ms-1">Sign In</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
