@model Alumni_Management_System.Models.ViewModels.ForgotPasswordViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Forgot Password / Username";
    var adminEmail = Configuration["AdminContactEmail"];
    Layout = "_AuthLayout";
}

<h2 class="auth-title"><i class="bi bi-key me-2"></i>Forgot Password / Username</h2>
<p class="auth-subtitle">
    Enter your username or email. If it matches an account, we'll email you your username and a
    temporary password right away. Forgot your username? Just enter your email.
</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-4">
        <label asp-for="UsernameOrEmail" class="form-label"><i class="bi bi-person-fill me-2"></i>Username or Email</label>
        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter your username or email" autofocus />
        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
    </div>

    <button type="submit" class="w-100 btn btn-usa mb-4">
        <i class="bi bi-send me-2"></i>Send Temporary Password
    </button>
</form>

@if (!string.IsNullOrWhiteSpace(adminEmail))
{
    <div class="auth-note mb-4">
        <i class="bi bi-envelope me-1"></i><strong>Still stuck?</strong>
        If you no longer have access to your email, contact the administrator at
        <a href="mailto:@adminEmail" class="link-text">@adminEmail</a>.
    </div>
}

<div class="text-center">
    <a asp-area="Identity" asp-page="/Account/Login" class="link-text"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
