@model Alumni_Management_System.Models.ViewModels.AlumniRegisterViewModel

@{
    ViewData["Title"] = "Complete Registration";
    Layout = "_AuthLayout";
}

<span class="auth-step">Alumni Registration &middot; Step 2 of 2</span>
<h2 class="auth-title"><i class="bi bi-person-plus me-2"></i>Create Your Account</h2>
<p class="auth-subtitle">
    <i class="bi bi-check-circle-fill text-success me-1"></i>JAG ID verified. Complete your details below.
</p>

<form asp-action="RegisterAlumni" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="JagId" class="form-label"></label>
        <input asp-for="JagId" class="form-control" readonly />
        <span asp-validation-for="JagId" class="text-danger"></span>
        <div class="form-text"><i class="bi bi-lock me-1"></i>Your verified JAG ID (cannot be changed)</div>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" readonly />
            <span asp-validation-for="FirstName" class="text-danger"></span>
            <div class="form-text"><i class="bi bi-lock me-1"></i>From Alumni Registry</div>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" readonly />
            <span asp-validation-for="LastName" class="text-danger"></span>
            <div class="form-text"><i class="bi bi-lock me-1"></i>From Alumni Registry</div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" placeholder="e.g., john_doe or john.doe123" maxlength="30" />
        <span asp-validation-for="Username" class="text-danger"></span>
        <div class="form-text">
            <i class="bi bi-exclamation-triangle text-warning me-1"></i><strong>Username cannot be changed later!</strong>
            Letters, numbers, dots and underscores only (3-30 characters).
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" placeholder="your.email@example.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <div class="form-text"><i class="bi bi-info-circle me-1"></i>Your primary contact email (can be changed later)</div>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <div id="pwMatch" class="form-text d-none"></div>
        </div>
        <div class="col-12 form-text mt-n2 mb-3">
            <ul id="pwRules" class="list-unstyled mb-0">
                <li data-rule="length"><i class="bi bi-circle me-1"></i>At least 8 characters</li>
                <li data-rule="upper"><i class="bi bi-circle me-1"></i>An uppercase letter</li>
                <li data-rule="lower"><i class="bi bi-circle me-1"></i>A lowercase letter</li>
                <li data-rule="digit"><i class="bi bi-circle me-1"></i>A number</li>
                <li data-rule="special"><i class="bi bi-circle me-1"></i>A special character</li>
            </ul>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="(555) 123-4567" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        <div class="form-text"><i class="bi bi-info-circle me-1"></i>Optional - you can update this later</div>
    </div>

    <button type="submit" class="w-100 btn btn-usa mb-3">
        <i class="bi bi-check-circle me-2"></i>Complete Registration
    </button>
    <a asp-action="VerifyJagId" class="w-100 btn btn-usa-outline">
        <i class="bi bi-arrow-left me-2"></i>Back to Verification
    </a>
</form>

<div class="auth-note mt-4">
    <i class="bi bi-shield-check me-1"></i><strong>Privacy &amp; security:</strong>
    Your information is only used for alumni management purposes. You can update your privacy settings after registration.
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Live feedback while typing, so a weak or mismatched password is
        // obvious before the form is submitted.
        (function () {
            const pw = document.getElementById('Password');
            const confirm = document.getElementById('ConfirmPassword');
            const match = document.getElementById('pwMatch');
            const rules = {
                length: v => v.length >= 8,
                upper: v => /[A-Z]/.test(v),
                lower: v => /[a-z]/.test(v),
                digit: v => /\d/.test(v),
                special: v => /[^a-zA-Z0-9]/.test(v)
            };

            function update() {
                const v = pw.value;
                document.querySelectorAll('#pwRules li').forEach(li => {
                    const icon = li.querySelector('i');
                    if (!v) { icon.className = 'bi bi-circle me-1'; return; }
                    icon.className = 'bi me-1 ' + (rules[li.dataset.rule](v)
                        ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger');
                });

                if (!confirm.value) { match.classList.add('d-none'); return; }
                const ok = confirm.value === v;
                match.classList.remove('d-none');
                match.className = 'form-text ' + (ok ? 'text-success' : 'text-danger');
                match.innerHTML = ok
                    ? '<i class="bi bi-check-circle-fill me-1"></i>Passwords match'
                    : '<i class="bi bi-x-circle-fill me-1"></i>Passwords do not match';
            }

            pw.addEventListener('input', update);
            confirm.addEventListener('input', update);
            update();
        })();
    </script>
}
