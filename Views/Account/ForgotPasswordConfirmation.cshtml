@{
    ViewData["Title"] = "Check Your Email";
    var adminEmail = ViewData["AdminContactEmail"] as string;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-envelope-check"></i> Check Your Email</h3>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-shield-check text-success" style="font-size:48px;"></i>
                    <p class="mt-3">
                        If that username or email matches an account, a temporary password has been emailed
                        to it. Log in with it and you'll be asked to set your own password right after.
                    </p>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Didn't get it, or can't access that email anymore? Contact your administrator at
                        <strong>@adminEmail</strong> - they can reset it for you directly.
                    </div>

                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
