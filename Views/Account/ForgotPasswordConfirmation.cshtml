@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AuthLayout";
    var adminEmail = ViewData["AdminContactEmail"] as string;
}

<div class="auth-icon success"><i class="bi bi-envelope-check-fill"></i></div>
<h2 class="auth-title">Check Your Email</h2>
<p class="auth-subtitle">
    If that username or email matches an account, your username and a temporary password have been emailed to it.
    Log in with it and you'll be asked to set your own password right after.
</p>

<div class="auth-note mb-4">
    <i class="bi bi-info-circle me-1"></i>
    Didn't get it, or can't access that email anymore? Contact your administrator at
    <a href="mailto:@adminEmail" class="link-text">@adminEmail</a> - they can reset it for you directly.
</div>

<a asp-area="Identity" asp-page="/Account/Login" class="w-100 btn btn-usa">
    <i class="bi bi-arrow-left me-2"></i>Back to Sign In
</a>
