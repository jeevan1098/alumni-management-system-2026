@using Alumni_Management_System.Services
@model Alumni_Management_System.Models.ViewModels.SiteContentEditViewModel

@{
    var definition = Model.Definition;
    ViewData["Title"] = "Edit " + definition.Title;
    var backUrl = !string.IsNullOrEmpty(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Index");
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="bi bi-pencil-square text-warning fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@definition.Title</h3>
                    <small class="text-info">@definition.Description</small>
                </div>
            </div>

            <hr class="mb-4" />

            <p class="small text-muted">
                @if (Model.Saved.IsCustomized)
                {
                    <span>Last changed @Model.Saved.UpdatedAt?.ToString("MMM d, yyyy h:mm tt") by @Model.Saved.UpdatedBy.</span>
                }
                else
                {
                    <span>Currently showing the default text.</span>
                }
            </p>

            <div class="row g-4">
                <!-- EDITOR -->
                <div class="col-lg-7">
                    <form asp-action="Edit" novalidate>
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger"></div>
                        }
                        <input type="hidden" asp-for="Key" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        @if (definition.HasSubject)
                        {
                            <div class="mb-3">
                                <label asp-for="Subject" class="form-label fw-semibold">Email subject</label>
                                <input asp-for="Subject" class="form-control" maxlength="200" />
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Body" class="form-label fw-semibold">
                                @(definition.Kind == SiteContentKind.Email ? "Email text" : "Text")
                            </label>
                            @if (definition.Kind == SiteContentKind.PlainText)
                            {
                                <input asp-for="Body" class="form-control" id="contentBody" maxlength="200" />
                            }
                            else
                            {
                                <textarea asp-for="Body" class="form-control font-monospace" id="contentBody" rows="18"></textarea>
                                <div class="form-text">
                                    Formatting: <code>## Heading</code>, <code>**bold**</code>, <code>*italic*</code>,
                                    <code>- list item</code>, <code>[link text](https://...)</code>. Leave a blank line between paragraphs.
                                </div>
                            }
                        </div>

                        @if (definition.Placeholders.Any())
                        {
                            <div class="mb-3">
                                <div class="fw-semibold mb-1">Placeholders</div>
                                <div class="form-text mb-2">Click one to insert it. It's replaced with the real value when the page is shown or the email is sent.</div>
                                <ul class="list-unstyled small mb-0">
                                    @foreach (var placeholder in definition.Placeholders)
                                    {
                                        <li class="mb-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 js-insert-placeholder" data-token="{{@placeholder.Name}}">{{@placeholder.Name}}</button>
                                            @placeholder.Description
                                            @if (placeholder.Required)
                                            {
                                                <span class="badge bg-danger ms-1">required</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
                            <a href="@backUrl" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-2"></i>Back
                            </a>
                            <div class="d-flex gap-2">
                                <button type="submit" name="submit" value="preview" class="btn btn-outline-primary rounded-pill px-4">
                                    <i class="bi bi-eye me-2"></i>Preview
                                </button>
                                <button type="submit" name="submit" value="save" class="btn btn-warning rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-check-circle-fill me-2"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (Model.Saved.IsCustomized)
                    {
                        <form asp-action="Reset" asp-route-id="@definition.Key" method="post" class="mt-3">
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="btn btn-link text-danger p-0 small">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to the default text
                            </button>
                            <span class="small text-muted">(the current version is kept as a backup)</span>
                        </form>
                    }
                </div>

                <!-- PREVIEW -->
                <div class="col-lg-5">
                    <div class="fw-semibold mb-2">
                        Preview
                        @if (definition.Kind == SiteContentKind.Email)
                        {
                            <small class="text-muted fw-normal">(with sample values)</small>
                        }
                    </div>
                    <div class="border rounded-3 p-3 bg-body-tertiary site-content">
                        @if (Model.PreviewSubject != null)
                        {
                            <div class="small text-muted mb-2">Subject: <strong>@Model.PreviewSubject</strong></div>
                            <hr class="my-2" />
                        }
                        @Html.Raw(Model.PreviewHtml)
                    </div>
                    <div class="form-text">Click Preview to update this after editing.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Inserts the clicked {{Placeholder}} at the cursor in the text box.
        document.querySelectorAll('.js-insert-placeholder').forEach(function (button) {
            button.addEventListener('click', function () {
                var box = document.getElementById('contentBody');
                var start = box.selectionStart, end = box.selectionEnd;
                box.value = box.value.slice(0, start) + button.dataset.token + box.value.slice(end);
                box.focus();
                box.selectionStart = box.selectionEnd = start + button.dataset.token.length;
            });
        });
    </script>
}
