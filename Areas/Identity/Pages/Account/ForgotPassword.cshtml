@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password - Alumni Management System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .forgot-container {
            max-width: 620px;
            width: 100%;
            margin: 20px;
        }

        .forgot-card {
            background: #ffffff;
            border-radius: 22px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.30);
            padding: 50px;
            text-align: center;
        }

        .icon-circle {
            width: 88px;
            height: 88px;
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .icon-circle i {
            font-size: 42px;
            color: white;
        }

        .forgot-title {
            font-size: 30px;
            font-weight: 700;
            color: #003366;
            margin-bottom: 12px;
        }

        .forgot-subtitle {
            color: #666;
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 28px;
        }

        .admin-box {
            background: #f4f8ff;
            border: 1px solid #d6e6ff;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 30px;
        }

        .admin-box p {
            margin-bottom: 10px;
            color: #444;
            font-weight: 500;
        }

        .admin-email {
            color: #003366;
            font-weight: 700;
            text-decoration: none;
            word-break: break-word;
        }

        .admin-email:hover {
            color: #0066cc;
            text-decoration: underline;
        }

        .btn-back {
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            border: none;
            border-radius: 10px;
            padding: 13px 24px;
            font-weight: 600;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-back:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 51, 102, 0.3);
        }

        .footer-text {
            color: white;
        }
    </style>
</head>

<body>
    <div class="forgot-container">
        <div class="forgot-card">
            <div class="icon-circle">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h2 class="forgot-title">Password Assistance</h2>

            <p class="forgot-subtitle">
                For security reasons, password reset requests are handled by the system administrator.
            </p>

            <div class="admin-box">
                <p>Please contact admin for further instructions:</p>

                <a href="mailto:socalumnimanagement@southalabama.edu" class="admin-email">
                    <i class="bi bi-envelope-fill me-2"></i>
                    socalumnimanagement@southalabama.edu
                </a>
            </div>

            <a asp-page="./Login" class="btn-back">
                <i class="bi bi-arrow-left me-2"></i>Back to Login
            </a>
        </div>

        <div class="text-center mt-4">
            <p class="footer-text">
                <small>&copy; @DateTime.Now.Year University of South Alabama. All rights reserved.</small>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>