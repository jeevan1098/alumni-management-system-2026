@page
@model LoginModel

@{
    ViewData["Title"] = "Login - Alumni Management System";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<h2 class="auth-title"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</h2>
<p class="auth-subtitle">Enter your credentials to access your account</p>
<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-4">
        <label asp-for="Input.Username" class="form-label"><i class="bi bi-person-fill me-2"></i>Username</label>
        <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your username" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock-fill me-2"></i>Password</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-4">
        <input class="form-check-input" asp-for="Input.RememberMe" />
        <label class="form-check-label" asp-for="Input.RememberMe">Remember me on this device</label>
    </div>
    <button id="login-submit" type="submit" class="w-100 btn btn-usa mb-4"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</button>
    <div class="text-center">
        <a id="forgot-password" asp-controller="Account" asp-action="ForgotPassword" class="link-text d-block mb-2"><i class="bi bi-question-circle me-1"></i>Forgot password or username?</a>
        @* <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="link-text d-block"><i class="bi bi-envelope-check me-1"></i>Resend email confirmation</a> *@
        <a id="resend-confirmation" asp-controller="Account" asp-action="VerifyJagId" class="link-text d-block"><i class="bi bi-person-plus me-1"></i>Register as a new Alumni</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
