@page
@model LoginModel

@{
    ViewData["Title"] = "Login - Alumni Management System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body {
            background: linear-gradient(135deg, #003366 0%, #0066cc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-container { max-width: 1000px; width: 100%; margin: 20px; }
        .login-card { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden; }
        .login-left { background: linear-gradient(135deg, #003366 0%, #0052a3 100%); color: white; padding: 60px 40px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
        .login-right { padding: 60px 50px; }
        .login-title { font-size: 28px; font-weight: 700; margin-bottom: 10px; color: #003366; }
        .login-subtitle { color: #666; margin-bottom: 30px; }
        .form-control { border-radius: 10px; padding: 12px 20px; border: 2px solid #e0e0e0; transition: all 0.3s; }
        .form-control:focus { border-color: #003366; box-shadow: 0 0 0 0.2rem rgba(0,51,102,0.15); }
        .btn-login { background: linear-gradient(135deg, #003366 0%, #0066cc 100%); border: none; border-radius: 10px; padding: 14px; font-weight: 600; font-size: 16px; transition: transform 0.2s; }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,51,102,0.3); }
        .welcome-text { font-size: 32px; font-weight: 700; margin-bottom: 20px; }
        .welcome-desc { font-size: 16px; opacity: 0.9; line-height: 1.6; }
        .feature-item { display: flex; align-items: center; margin: 15px 0; font-size: 14px; }
        .feature-item i { font-size: 24px; margin-right: 15px; color: #ffd700; }
        .link-text { color: #003366; text-decoration: none; font-weight: 500; transition: color 0.2s; }
        .link-text:hover { color: #0066cc; }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="row g-0">
                <div class="col-md-5 login-left">
                    <div>
                        <i class="bi bi-mortarboard-fill" style="font-size: 80px; margin-bottom: 20px;"></i>
                        <h1 class="welcome-text">Welcome Back!</h1>
                        <p class="welcome-desc">University of South Alabama<br/>Alumni Management System</p>
                        <hr style="border-color: rgba(255,255,255,0.3); width: 80%; margin: 30px auto;" />
                        <div class="text-start" style="max-width: 300px;">
                            <div class="feature-item"><i class="bi bi-people-fill"></i><span>Connect with fellow alumni</span></div>
                            <div class="feature-item"><i class="bi bi-briefcase-fill"></i><span>Track your career journey</span></div>
                            <div class="feature-item"><i class="bi bi-calendar-event-fill"></i><span>Stay updated with events</span></div>
                            <div class="feature-item"><i class="bi bi-chat-dots-fill"></i><span>Receive important messages</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7 login-right">
                    <h2 class="login-title"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</h2>
                    <p class="login-subtitle">Enter your credentials to access your account</p>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-4">
                            <label asp-for="Input.Username" class="form-label fw-semibold"><i class="bi bi-person-fill me-2"></i>Username</label>
                            <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your username" />
                            <span asp-validation-for="Input.Username" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label fw-semibold"><i class="bi bi-lock-fill me-2"></i>Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Remember me on this device</label>
                        </div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-login mb-4"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</button>
                        <div class="text-center">
                            <a id="forgot-password" asp-page="./ForgotPassword" class="link-text d-block mb-2"><i class="bi bi-question-circle me-1"></i>Forgot your password?</a>

                            <a id="resend-confirmation" asp-controller="Account" asp-action="VerifyJagId" class="link-text d-block"><i class="bi bi-envelope-check me-1"></i>Register as a new Alumni</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="text-center mt-4"><p class="text-white"><small>&copy; @DateTime.Now.Year University of South Alabama. All rights reserved.</small></p></div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
