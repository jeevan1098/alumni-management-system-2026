@page
@model LoginWith2faModel

@{
    ViewData["Title"] = "Verify Your Identity - Alumni Management System";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <style>
        .code-input { letter-spacing: 6px; text-align: center; font-size: 22px; }
    </style>
}

<div class="auth-icon"><i class="bi bi-envelope-check-fill"></i></div>
<h2 class="auth-title">Check Your Email</h2>
<p class="auth-subtitle">We sent a verification code to your email address. Enter it below to finish signing in.</p>

@if (ViewData["ResentMessage"] != null)
{
    <div class="alert alert-success">@ViewData["ResentMessage"]</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="RememberMe" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    <div class="mb-4">
        <label asp-for="Input.Code" class="form-label">Verification Code</label>
        <input asp-for="Input.Code" class="form-control code-input" autocomplete="one-time-code" placeholder="000000" maxlength="8" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <button type="submit" class="w-100 btn btn-usa mb-3">
        <i class="bi bi-check-circle me-2"></i>Verify
    </button>
</form>

<form method="post" asp-page-handler="Resend">
    <input type="hidden" asp-for="RememberMe" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="text-center">
        <button type="submit" class="link-text">
            <i class="bi bi-arrow-repeat me-1"></i>Didn't get a code? Resend
        </button>
    </div>
</form>

<div class="text-center mt-2">
    <a asp-page="./Login" class="link-text"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
